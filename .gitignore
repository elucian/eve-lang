
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
# ...except expected test output (script/runtest.py)
!/test/**/*.out
*.app
.DS_Store

# Zig build output (evevm/); `zig build -p ..` installs eve.exe + eve.pdb into /bin
.zig-cache/
zig-out/
zig-pkg/
/bin/

# Claude Code local files
.claude/settings.local.json
__pycache__/

# Eve tutorial: junction to ../scl/projects/eve (tracked in the scl repo)
/tutorial

# Scratch space for temporary scripts and output (kept empty in git)
/temp/*
!/temp/.gitkeep
# Test reports from script/runtest.py
/temp/output/
# Files written by project tests (test/levelN/<name>/out/, emptied before each run)
/test/**/out/
