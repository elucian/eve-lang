# smoke: numbers. Zero, one, the extremes of the types, the operators and the literals.
** spec: syntax/expressions.md#operators
driver numeric is
  function zero() => (@r: Integer) is
    let r := 0;
  return;

  function one() => (@r: Integer) is
    let r := 1;
  return;

  function limit() => (@r: Integer) is
    let r := 9223372036854775807;
  return;

  function arithmetic() => (@r: Logic) is
    let r := (0 + 0 == 0) and (1 - 1 == 0) and (2 * 3 == 6) and (10 / 2 == 5) and (7 % 3 == 1) and (2 ^ 10 == 1024);
    let r := r and (1 + 2 * 3 == 7) and ((1 + 2) * 3 == 9) and (-(-4) == 4) and (0 * 99 == 0) and (0 - 0 == 0);
  return;

  function literals() => (@r: Logic) is
    let r := (0xFF == 255) and (0b101 == 5) and (0.5 == 0.5) and (-0 == 0) and (0.0 == 0);
  return;

  process main is
    expect 0 == 0;
    expect 1 == 1;
    expect 0 <> 1;
    expect 0 < 1;
    expect 1 > 0;
    expect 0 <= 0;
    expect 0 >= 0;
    expect not (0 < 0);
    expect not (1 < 0);
    expect zero() == 0;
    expect one() == 1;
    expect zero() < one();
    expect zero() + one() == one();
    expect one() - one() == zero();
    expect one() * zero() == zero();
    expect arithmetic();
    expect literals();
    expect limit() > 0;
    expect limit() == 9223372036854775807;
    expect -limit() < 0;
    expect limit() - limit() == 0;
    expect limit() > limit() - 1;
    expect 1.5 + 1.5 == 3.0;
    expect 0.5 < 1;
    expect 2.0 * 0.5 == 1;
    expect type(1) == Integer;
    expect type(1.5) == Real;
    new i :Integer;
    new r :Real;
    new n :Natural;
    expect i == 0;
    expect r == 0;
    expect n == 0;
    expect i + r == 0;
    let i += 5;
    let i -= 5;
    expect i == 0;
    print "numeric: ok";
  return;
end numeric;
/*@expect
{
  "stdout": ["numeric: ok"]
}
