# Placeholders. Names, literals, expressions, formats, code points, entities, braces.
** spec: lexical/lexical.md#literals
driver s15_placeholders is
  process main is
    new n := 42;
    new s := "Eve";
    new pi := 3.14159;
    new ok := True;
    expect "{n}" == "42";
    expect "{s}" == "Eve";
    expect "{ok}" == "True";
    expect "n = {n}, s = {s}" == "n = 42, s = Eve";
    expect "{399}" == "399" and "{"test"}" == "test" and "{(1,2,3)}" == "(1,2,3)";
    expect "{n + 1}" == "43" and "{n * 2 - 2}" == "82" and "{s.length()}" == "3" and "{n > 40}" == "True";
    expect "{s + "!"}" == "Eve!";
    expect "{n % i5}" == "   42";
    expect "{n % 0>i5}" == "00042";
    expect "{n % <i5}|" == "42   |";
    expect "{pi % f8.2}" == "    3.14";
    expect "{s % *^9}" == "***Eve***";
    expect "{s % .2}" == "Ev";
    expect "{ok % yn}" == "Yes";
    expect "{U+0041}" == "A" and "{U+03B1}" == "α";
    expect "&alpha;&beta;" == "αβ";
    expect "\{x\}".length() == 3;
    expect "\{{n}\}".length() == 4;
    expect "a\tb".length() == 3;
    expect "&amp;" == "&" and "\&".length() == 1;
    new l := (10, 20, 30);
    expect "{l[2]}" == "20" and "{l[-1]}" == "30";
    new m := {"k": 7};
    expect "{m["k"]}" == "7";
    print "placeholders: ok";
  return;
end s15_placeholders;
