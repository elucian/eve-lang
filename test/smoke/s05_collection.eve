# Collections. The empty ones, zero values, one element, indexes from 1, literals.
** spec: semantics/types.md#composite-types
driver s05_collection is
  function nothing() => (@r: Integer) is
    let r := ().count();
  return;

  process main is
    expect nothing() == 0;
    expect ().count() == 0;
    expect [].count() == 0;
    expect {}.count() == 0;
    expect {:}.count() == 0;
    expect (7,).count() == 1;
    expect (1, 2, 3).count() == 3;
    expect [1, 2, 3].count() == 3;
    expect {1, 2, 3}.count() == 3;
    expect {1, 1, 2, 2, 3}.count() == 3;
    expect {"a": 1, "b": 2}.count() == 2;
    expect (1, 2, 3)[1] == 1;
    expect (1, 2, 3)[3] == 3;
    expect (1, 2, 3)[-1] == 3;
    expect [4, 5, 6][2] == 5;
    expect {"a": 1}["a"] == 1;
    expect (1, 2) == (1, 2);
    expect (1, 2) <> (2, 1);
    expect () == ();
    expect {1, 2} == {2, 1};
    expect 2 in (1, 2, 3);
    expect not (4 in (1, 2, 3));
    expect type(()) == List;
    expect type([]) == Array;
    expect type({}) == DataSet;
    new l :()Integer;
    expect l.count() == 0;
    new a :[3]Integer;
    expect a.count() == 3;
    expect a[1] == 0;
    expect a[3] == 0;
    let l <+ 5;
    let l <+ 6;
    expect l.count() == 2;
    expect l[1] == 5;
    expect l[2] == 6;
    new c := (1, (2, 3), [4]);
    expect c.count() == 3;
    expect c[2][1] == 2;
    new total := 0;
    for e in (1, 2, 3, 4) do
      let total += e;
    done;
    expect total == 10;
    print "collection: ok";
  return;
end s05_collection;
/*@expect
{
  "stdout": ["collection: ok"]
}
*/
