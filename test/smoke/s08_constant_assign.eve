# A constant can't be changed. Assigning it is a compile error and nothing runs.
** spec: syntax/declarations.md#variables-and-constants
driver s08_constant_assign is
  set LIMIT = 10;

  process main is
    print "never";
    let LIMIT := 11;
  return;
end s08_constant_assign;
