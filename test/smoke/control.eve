# smoke: control flow. if, while, loop, for, match, break, skip, labels, the if suffix.
** spec: semantics/control.md#loops
driver control is
  function sign(x: Integer) => (@r: Integer) is
    if x > 0 do
      let r := 1;
    else if x < 0 do
      let r := -1;
    else
      let r := 0;
    done;
  return;

  function name_of(x: Integer) => (@r: String) is
    match x
      when 1 do
        let r := "one";
      when (2..5) do
        let r := "few";
      when (6, 7) do
        let r := "six or seven";
      when other do
        let r := "many";
    done;
  return;

  process main is
    expect sign(5) == 1 and sign(-5) == -1 and sign(0) == 0;
    expect name_of(1) == "one" and name_of(3) == "few" and name_of(7) == "six or seven" and name_of(99) == "many";
    new sum := 0;
    for i in (1..5) do
      let sum += i;
    done;
    expect sum == 15;
    let sum := 0;
    for x in (10, 20, 30) do
      let sum += x;
    done;
    expect sum == 60;
    let sum := 0;
    for i in (1..10) do
      skip if i % 2 == 0;
      break if i > 7;
      let sum += i;
    done;
    expect sum == 16;
    new k := 0;
    while k < 5 do
      let k += 1;
    done;
    expect k == 5;
    let k := 0;
    while True do
      let k += 1;
      break if k == 3;
    done;
    expect k == 3;
    let sum := 0;
    outer: loop
    for i in (1..3) do
      for j in (1..3) do
        skip outer if j == 2;
        let sum += 1;
      done;
    done outer;
    expect sum == 3;
    let sum := 0;
    for i in (3..1) do
      let sum += 1;
    done;
    expect sum == 0;
    print "control: ok";
  return;
end control;
/*@expect
{
  "stdout": ["control: ok"]
}
*/
