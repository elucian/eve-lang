# a primary aspect is serial: it applies its private processes, it does not start them
** spec: syntax/declarations.md#scripts
primary aspect d38_primary_start_private is
  process work is
    print "work";
  return;

  process main is
    parallel
    do
      start work();                    ** compile error
    done;
  return;
end d38_primary_start_private;
