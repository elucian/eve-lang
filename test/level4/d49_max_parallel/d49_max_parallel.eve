# $cores is the number of hardware cores (1 to 16) and $max_parallel the tasks of a group that run at a time (default 8): a start beyond it waits until a task of the group has ended, and the output keeps the order of start
** spec: semantics/multitasking.md#where-a-group-is-allowed
primary aspect d49_max_parallel is
  process main is
    expect $cores >= 1 and $cores <= 16;
    print $max_parallel;
    fs.write("out/trace.txt", "");
    let $max_parallel := 2;
    parallel
    do
      for k in (1..5) do
        start visit(k);
      done;
    done;
    print fs.lines!("out/trace.txt").count();
  return;
end d49_max_parallel;
