# $cores is the number of hardware cores (1 to 16) and $max_parallel the tasks of a group that run at a time (default 8): a start beyond it waits until a task of the group has ended
** spec: semantics/multitasking.md#where-a-group-is-allowed
primary aspect d49_max_parallel is
  from lib use (gauge);

  process main is
    expect $cores >= 1 and $cores <= 16;
    print $max_parallel;
    let $max_parallel := 2;
    parallel
    do
      for k in (1..5) do
        start visit(k);
      done;
    done;
    print "{gauge.visits!()} visits, at most {gauge.top!()} at the same time";
  return;
end d49_max_parallel;
/*@expect
{
  "stdout": ["8", "5 visits, at most 2 at the same time"]
}
*/
