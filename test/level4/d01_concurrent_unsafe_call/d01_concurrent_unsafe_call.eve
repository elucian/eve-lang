# the compiler flags the call of an unsafe module from a concurrent aspect (D-129)
** spec: semantics/modules.md#safe-and-unsafe-modules
driver d01_concurrent_unsafe_call is
  process main is
    apply worker();
  return;
end d01_concurrent_unsafe_call;
