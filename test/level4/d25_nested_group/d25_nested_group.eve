# an exclusive aspect applied by the primary aspect opens a group of two concurrent leaf aspects; outputs keep the order of start (D-140, D-183)
** spec: semantics/multitasking.md#where-a-group-is-allowed
primary aspect d25_nested_group is
  process main is
    new r: [2]Integer;
    apply outer(1, @r[1]);
    apply outer(2, @r[2]);
    print "{r[1]} {r[2]}";
  return;
end d25_nested_group;
/*@expect
{
  "stdout": [
    "leaf 1",
    "leaf 2",
    "leaf 3",
    "leaf 4",
    "5 25"
  ]
}
*/
