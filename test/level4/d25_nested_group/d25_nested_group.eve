# the primary aspect opens a group of concurrent aspects; outputs keep the order of start (D-206: only the primary aspect fans out)
** spec: semantics/multitasking.md#where-a-group-is-allowed
primary aspect d25_nested_group is
  process main is
    new a, b, c, d :Integer;
    parallel
    do
      start leaf(1, @a);
      start leaf(2, @b);
      start leaf(3, @c);
      start leaf(4, @d);
    done;
    print "{a} {b} {c} {d}";
  return;
end d25_nested_group;
/*@expect
{
  "stdout": [
    "leaf 1",
    "leaf 2",
    "leaf 3",
    "leaf 4",
    "1 4 9 16"
  ]
}
*/
