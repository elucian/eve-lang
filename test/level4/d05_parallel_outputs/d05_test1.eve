# variation 1 of d05: start inside if, inputs by value, a declaration local to the group (D-140)
** spec: semantics/multitasking.md#data-rules
driver d05_test1 is
  process main is
    new n := 3;
    new s: [3]Integer;
    parallel
      new limit := 2;                  ** local to the group
    do
      for i in (1..3) do
        if i <= limit do
          start square(n, @s[i]);      ** n is copied at start
        done;
        let n += 1;
      done;
    done;
    print "{s[1]} {s[2]} {s[3]}";
  return;
end d05_test1;
