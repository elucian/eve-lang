# an aspect group holds at most two start statements (D-081, D-140)
** spec: semantics/multitasking.md#where-a-group-is-allowed
primary aspect d26_nested_too_many is
  process main is
    new r: Integer;
    apply outer(1, @r);
  return;
end d26_nested_too_many;
