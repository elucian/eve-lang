# a class that does not write a required method of its trait is a compile error (D-145)
** spec: syntax/declarations.md#traits-and-generic-classes
driver d21_trait_missing_method is
  trait Describable is
    method describe(@self) => (@result: String);
    method show(@self) is
      print "<{self.describe()}>";
    return;
  end Describable;

  class Point = {x: Integer, y: Integer} <: (Object, Describable);   ** compile error: describe is missing

  process main is
    new p := Point(x: 1, y: 2);
    p.show();
  return;
end d21_trait_missing_method;
/*@expect
{
  "syntax_error": true,
  "exit": 65,
  "contains": [
    "Point does not implement describe"
  ]
}
*/
