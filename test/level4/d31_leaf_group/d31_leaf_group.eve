# a concurrent aspect may open a group that starts its own private processes; the primary aspect calls it
** spec: semantics/multitasking.md#what-can-be-started
primary aspect d31_leaf_group is
  process main is
    new r: Integer;
    apply leaf(@r);
    print r;
  return;
end d31_leaf_group;
/*@expect
{
  "stdout": [
    "work 1",
    "work 2",
    "3"
  ]
}
*/
