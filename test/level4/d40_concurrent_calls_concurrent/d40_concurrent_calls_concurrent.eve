# a concurrent aspect does not call another concurrent aspect (D-183)
** spec: syntax/declarations.md#scripts
primary aspect d40_concurrent_calls_concurrent is
  process main is
    apply outer();
  return;
end d40_concurrent_calls_concurrent;
