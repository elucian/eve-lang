# start of an aspect without a kind word is a compile error: it is exclusive
** spec: semantics/multitasking.md#what-can-be-started
primary aspect d06_start_exclusive is
  process main is
    parallel
    do
      start report(1);                 ** compile error: report is exclusive
    done;
  return;
end d06_start_exclusive;
