# a consumer that waits on a channel nobody sends to is a deadlock; the error names it (D-141)
** spec: semantics/multitasking.md#channels
driver d14_deadlock is
  process main is
    new jobs := Channel(:Integer)(capacity: 5);
    parallel
    do
      start consume(@jobs);
    done;
  recover
    print $error.message;
    print $error.errors[1].message;
    print "code: {$error.errors[1].code}";
  return;
end d14_deadlock;
/*@expect
{
  "stdout": [
    "1 of 1 tasks failed",
    "Deadlock: consume waits to receive from jobs",
    "code: 42"
  ]
}
