# builders: [f(x) | x in src and cond], a set builder, ranges with excluded ends, while with else and a header, =~ +-
** runs on the bytecode machine (test/readme.md, "Which engine runs which test"); the golden listing is bc29_builders.lst
primary aspect bc29_builders is
  process main is
    new xs := [x * x | x in (1..6) and x % 2 == 1];
    new ws := {w | w in ("a", "b", "a")};
    new n := 2;
    print xs, ws.count(), [x + n | x in xs], (x | x in (1, 2));
    for i in (1>..<4) do
      print i;
    done;
    for i in (1..<3) do
      print i;
    done;
    while n > 5 do
      print "never";
    else
      print "else";
    done;
    loop new steps := 2;
    while steps > 0 do
      let steps -= 1;
    done;
    print 3.14159 =~ 3.14 +- 0.01, 3.2 =~ 3.14 +- 0.01;
  return;
end bc29_builders;
