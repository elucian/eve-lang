# indexv and index_setv: several indexes, slices (views), `*`, `$`, chains on lists and matrices, compound assignment, strings and maps
** runs on the bytecode machine (test/readme.md, "Which engine runs which test"); the golden listing is bc28_indexes.lst
primary aspect bc28_indexes is
  process main is
    new v := [10, 20, 30, 40];
    new m := [[1, 2, 3], [4, 5, 6]];
    new w := ((1, 2), (3, 4));
    print v[2..3], v[3..-1], v[$], v[2..$], v[1..$ - 1];
    print m[2, 3], m[2][3], m[-1, 1], m[5], m[1, *], m[*, 2];
    print w[2][1], "hello"[2..4], "hello"[$];
    let v[1..2] := 7;
    let m[2, 1] := 40;
    let m[1, 3] += 100;
    let v[$] -= 1;
    new h := {"a": 1};
    let h["a"] += 10;
    print v, m, h["a"];
    new view := v[1..2];
    let v[1] := 99;
    print view[1];
    print v[9];
  return;
end bc28_indexes;
