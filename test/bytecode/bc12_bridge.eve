# a loop over a list literal runs natively: iterprep and iterloop
** runs on the bytecode machine (test/readme.md, "Which engine runs which test"); the golden listing is bc12_bridge.lst
primary aspect bc12_bridge is
  process main is
    new total := 0;
    for x in (4, 5, 6) do
      let total += x;
    done;
    print total;
  return;
end bc12_bridge;
/*@expect
{
  "stdout": [
    "15"
  ]
}
*/
