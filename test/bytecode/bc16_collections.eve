# lists, maps and sets: literals, index and store, push, loops over each kind, empty collections
** runs on the bytecode machine (test/readme.md, "Which engine runs which test"); the golden listing is bc16_collections.lst
primary aspect bc16_collections is
  process main is
    new xs := (5, 6, 7);
    new m := {"one": 1, "two": 2};
    new s := {3, 1, 2, 3};
    for x in xs do
      write "{x} ";
    done;
    print "";
    for k in m do
      print k;
    done;
    for v in s do
      write "{v} ";
    done;
    print "";
    for c in "abc" do
      write c;
    done;
    print "";
    let xs[2] := 60;
    let xs[-1] := 70;
    let xs <+ 80;
    print xs;
    let m["three"] := 3;
    print m["three"] + m["one"];
    let s <+ 9;
    print s.count();
    print 9 in s;
    new empty := ();
    for e in empty do
      print "never";
    else
      print "nothing to visit";
    done;
    new total := 0;
    for y in (1, 2, 3, 4) do
      if y == 3 do
        skip;
      done;
      if y == 4 do
        break;
      done;
      let total += y;
    done;
    print total;
  return;
end bc16_collections;
