# what the emitter does not translate runs on the tree walker (TD-46)
** runs on the bytecode machine (test/readme.md, Bytecode tests); the golden listing is bridge.lst
primary aspect bridge is
  process main is
    new xs := (3, 1, 2);
    print xs.count();
    new total := 0;
    for x in xs do
      let total += x;
    done;
    print total;
  return;
end bridge;
