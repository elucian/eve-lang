# loops that pull: a range value, a generator closed by break, a channel; break in a loop over a variable; await and panic
** runs on the bytecode machine (test/readme.md, "Which engine runs which test"); the golden listing is bc33_iterate.lst
primary aspect bc33_iterate is
  generator naturals() => (@n: Integer) is
    new k := 0;
    defer print "naturals closed";
    while True do
      let k += 1;
      yield k;
    done;
  return;

  function keep(xs, f) => (@r: List) is
    let r := xs;
  return;

  function total(*nums) => (@t: Integer) is
    for v in nums do
      let t += v;
    done;
  return;

  process main is
    new ys := (5, 6);
    new q, rr := (17, 5);
    new (u, v) = 7;
    new h, *mid, t := (1, 2, 3, 4);
    new nothing :Integer?;
    print q, rr, u, v, h, mid, t, nothing ?? 9, ys[1] ?? 0;
    wait 1ms;
    new a, b :Integer;
    new z :[3]Integer;
    let z[2] := 7;
    new ch := Channel(:Integer)(capacity: 2);
    new log := (0);
    print a, b, z;
    print keep(ys, (v) => (v)).count(), keep(ys, (v) => (v))[2], total(1, 2, 3);
    new xs := (1, 2, 3, 4);
    for x in xs do
      break if x == 3;
      print x;
    done;
    new r := (1..3);
    for i in r do
      print "r {i}";
    done;
    for n in naturals() do
      print "n {n}";
      break if n == 2;
    done;
    print "end";
    panic if xs.count() == 4;
    print "never";
  return;
end bc33_iterate;
