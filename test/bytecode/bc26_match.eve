# match, repeat, and the declarations: zero values, copies, ranges and object literals as values
** runs on the bytecode machine (test/readme.md, "Which engine runs which test"); the golden listing is bc26_match.lst
primary aspect bc26_match is
  process main is
    for n in (1, 3, 5, 8, 20) do
      match n
        when 1 do
          print "one";
        when (3, 4) do
          print "three or four";
        when (5..9) do
          print "five to nine";
        when other do
          print "other";
      done;
    done;
    match "b" all
      when ("a", "b") do
        print "first";
      when "b" do
        print "second";
      when "c" do
        print "never";
    done;
    new k := 0;
    loop do
      let k += 1;
      skip if k == 2;
      break if k > 4;
      print k;
    repeat while True;
    new m := 0;
    loop do
      let m += 1;
    repeat while m < 3;
    print m;
    new z :Integer;
    new w :String?;
    new xs := (1, 2);
    new ys :: xs;
    let ys <+ 3;
    new r := (2..4);
    new p := {x: 1, y: z + 2};
    print z, w, xs.count(), ys.count(), 3 in r, p.y;
  return;
end bc26_match;
/*@expect
{
  "stdout": ["one", "three or four", "five to nine", "five to nine", "other", "first", "second", "1", "3", "4", "3", "0,null,2,3,True,2"]
}
*/
