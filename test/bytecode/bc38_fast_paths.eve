# the fast paths of the arithmetic and of the comparisons give the results of the general path
** runs on the bytecode machine (test/readme.md, "Which engine runs which test"); the golden listing is bc38_fast_paths.lst
primary aspect bc38_fast_paths is
  process main is
    new i := 7;
    new x := 2.5;
    new big := 9223372036854775800;
    print i + 3, i - 10, i * 4, i % 4, -7 % 4;
    print x + 1, x - 1, x * 2, i + x, i * x, x / 2, i / 2, 7 / 2.0;
    print i < 8, i <= 7, i > 7, i >= 8, i == 7, i <> 7;
    print x < 3, x <= 2.5, x > 2, x >= 3, x == 2.5, x <> 2.5;
    print i == 7.0, x < 3, 1 < 2.5, 3 >= 2.5;
    new nan := 0.0 / 1.0;
    new l := (1, 2, 3);
    let l += 1;
    print l;
    let i += 5;
    let i -= 2;
    let i *= 3;
    print i;
    new k := 0;
    while k < 5 do
      let k += 2;
    done;
    print k;
    if k == 6 do
      print "six";
    else
      print "other";
    done;
    if x > 2.0 do
      print "big x";
    done;
    if i <> 30 do
      print "not 30";
    done;
    let big += 100;
    print "never";
  return;
end bc38_fast_paths;
