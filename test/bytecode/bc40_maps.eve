# maps and sets keep their keys sorted and find them by halving: any order of insertion, misses, replacements, mixed number keys
** runs on the bytecode machine (test/readme.md, "Which engine runs which test"); the golden listing is bc40_maps.lst
primary aspect bc40_maps is
  process main is
    new m := {:};
    for i in (1..200) do
      let m[(i * 37) % 211] := i;
    done;
    let m[5] := 1000;
    print m.count(), m[5], m[37];
    print 4 in m, 5 in m, 210 in m, 211 in m;
    new first := 0;
    new last := 0;
    new n := 0;
    for (k: v) in m do
      let n += 1;
      if n == 1 do
        let first := k;
      done;
      let last := k;
    done;
    print first, last;
    new w := {:};
    let w["pear"] := 1;
    let w["apple"] := 2;
    let w["fig"] := 3;
    let w["apple"] := 4;
    print w["apple"], w["fig"], w.count(), "kiwi" in w;
    new r := {:};
    let r[2.5] := "a";
    let r[1] := "b";
    let r[3] := "c";
    print r[1], r[2.5], r[3], 2 in r, 2.5 in r;
    new s := {5, 3, 9};
    let s <+ 7;
    let s <+ 3;
    let s <+ 1;
    print s, 7 in s, 4 in s, s.count();
    print m[999];
  return;
end bc40_maps;
