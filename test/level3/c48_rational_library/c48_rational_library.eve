# library math, module rational: of, numerator, denominator, reciprocal, truncate, is_whole, to_real, from_real, parse, mediant, continued
** spec: library/math.md#module-rational
primary aspect c48_rational_library is
  from lib use (math);

  function code_of_zero() => (@r :Integer) is
    new x := math.of(1, 0);
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_reciprocal() => (@r :Integer) is
    new x := math.reciprocal(0\1);
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_parse() => (@r :Integer) is
    new x := math.parse("three quarters");
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_from_real() => (@r :Integer) is
    new x := math.from_real(0.5, 0);
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_type() => (@r :Integer) is
    new x := math.numerator("1");
    let r := 0;
  recover
    let r := $error.code;
  return;

  process main is
    expect math.of(6, -8) == -3\4;
    expect math.of(0, -8) == 0;
    expect math.of(10, 5) == 2;
    expect math.numerator(-3\4) == -3;
    expect math.denominator(-3\4) == 4;
    expect math.numerator(6\8) == 3;
    expect math.numerator(5) == 5;
    expect math.denominator(5) == 1;
    expect math.reciprocal(3\4) == 4\3;
    expect math.reciprocal(-3\4) == -4\3;
    expect math.reciprocal(2) == 1\2;
    expect math.truncate(7\2) == 3;
    expect math.truncate(-7\2) == -3;
    expect floor(-7\2) == -4;
    expect ceiling(-7\2) == -3;
    expect round(-7\2) == -4;
    expect round(7\2) == 4;
    expect round(10\3) == 3;
    expect round(11\3) == 4;
    expect floor(5\1) == 5;
    expect math.is_whole(4\2);
    expect not math.is_whole(5\2);
    expect math.to_real(1\8) == 0.125;
    expect math.to_real(-1\4) == -0.25;
    expect math.from_real(0.75, 100) == 3\4;
    expect math.from_real(0.5, 1) == 1;
    expect math.from_real(0.3333333333333333, 1000) == 1\3;
    expect math.from_real(-2.5, 10) == -5\2;
    expect math.from_real(3.14159265358979, 113) == 355\113;
    expect math.from_real(3.14159265358979, 7) == 22\7;
    expect math.from_real(2, 10) == 2;
    expect math.from_real(1.4142135623730951, 100) == 140\99;
    expect math.from_real(2.718281828459045, 100000) == 271801\99990;
    expect math.from_real(0.1, 1000) == 1\10;
    expect math.from_real(0.7, 10) == 7\10;
    expect math.from_real(0.34, 3) == 1\3;
    expect math.parse("3\\4") == 3\4;
    expect math.parse("3/4") == 3\4;
    expect math.parse("-6/8") == -3\4;
    expect math.parse("7") == 7;
    expect math.parse(" 5/10 ") == 1\2;
    expect math.mediant(1\2, 2\3) == 3\5;
    expect math.mediant(0, 1) == 1\2;
    expect math.mediant(1\3, 1\2) == 2\5;
    expect math.continued(355\113) == (3, 7, 16);
    expect math.continued(7).sum() == 7;
    expect math.continued(7).length() == 1;
    expect math.continued(-7\2) == (-4, 2);
    expect math.continued(0\1).length() == 1;
    expect math.continued(0\1).sum() == 0;
    expect math.abs(-3\4) == 3\4;
    expect math.abs(3\4) == 3\4;
    expect math.sign(-3\4) == -1;
    expect math.sign(0\1) == 0;
    expect math.sign(1\1000) == 1;
    expect math.min(1\3, 1\2) == 1\3;
    expect math.max(1\3, 1\2) == 1\2;
    expect math.max(1\3, 1) == 1;
    expect math.clamp(3\2, 0, 1) == 1;
    expect math.clamp(-1\2, 0, 1) == 0;
    expect math.clamp(1\2, 0, 1) == 1\2;
    expect math.pow(2\3, 3) == 8\27;
    expect math.pow(2\3, -3) == 27\8;
    expect math.pow(5\7, 0) == 1;
    expect math.sqrt(1\4) == 0.5;
    expect math.sqrt(9\4) == 1.5;
    expect math.cbrt(8\27) > 0.6666;
    expect math.exp(0\1) == 1.0;
    expect code_of_zero() == $err_divide;
    expect code_of_reciprocal() == $err_divide;
    expect code_of_parse() == $err_parse;
    expect code_of_from_real() == $err_argument;
    expect code_of_type() == $err_argument;
    print math.from_real(0.1, 1000);
    print math.continued(math.from_real(2.718281828459045, 100000));
    print math.rational.mediant(1\2, 1\2);
  return;
end c48_rational_library;
/*@expect
{
  "stdout": ["1\\10", "(2,1,2,1,1,4,1,1,6,1,1,8,1,1,5)", "1\\2"]
}
*/
