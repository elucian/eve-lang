# a managed module is accepted: no variable, no unsafe call (D-129)
** spec: semantics/modules.md#managed-and-direct-modules
driver c28_managed_module is
  from lib use (pure);

  process main is
    expect pure.twice(4) == 8;
    print "twice: {pure.twice(4)}";
  return;
end c28_managed_module;
