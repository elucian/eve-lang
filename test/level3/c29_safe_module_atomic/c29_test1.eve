# variation 1 of c29: the atomic counter, many times (D-133)
** spec: semantics/modules.md#safe-and-unsafe-modules
driver c29_test1 is
  from lib use (hits);

  process main is
    for i in (1..5) do
      hits.record();
    done;
    expect hits.total!() == 5;
    print "hits: {hits.total!()}";
  return;
end c29_test1;
