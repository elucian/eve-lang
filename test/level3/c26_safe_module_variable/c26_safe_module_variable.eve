# a safe module is rejected when it has a variable that is not atomic (D-129)
** spec: semantics/modules.md#safe-and-unsafe-modules
driver c26_safe_module_variable is
  from lib use (shared);

  process main is
    print "never";
  return;
end c26_safe_module_variable;
