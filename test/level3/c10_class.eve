# class with a constructor, methods, visibility, reference and clone (D-076, D-084, D-085)
** spec: syntax/declarations.md#classes-and-objects
driver c10_class is
  class Point = {x, y :Integer} <: Object is
    constructor(x = 0, y = 0 :Integer) => (@self) is
      let self := Object();
      let self.x := x;
      let self.y := y;
    return;

    public method move(@self, dx, dy :Integer) is
      let self.x += dx;
      let self.y += dy;
    return;

    public method string(@self) => (@result :String) is
      let result := "({self.x}, {self.y})";
    return;
  end Point;

  process main is
    new p := Point(1, 2);
    expect p.x == 1;
    expect p.y == 2;
    new o := Point();
    expect o.x == 0;
    new n := Point(y: 5);
    expect n.y == 5;

    p.move(2, 3);
    expect p.x == 3;
    expect p.y == 5;
    print p.string();

    new r := p;                  ** the same object
    let r.x := 50;
    expect p.x == 50;
    new c :: p;                  ** a copy
    let c.x := 100;
    expect p.x == 50;
    expect p is r;
    expect p is not c;
  return;
end c10_class;
