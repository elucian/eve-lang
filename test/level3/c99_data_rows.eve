    "{\"Cluj\":14.50,\"Iasi\":3.25,\"Oslo\":1.00}",
    "2,2,Cluj,Cluj",
    "(\"a-RO\",\"b-RO\",\"a-NO\")",
    "(\"RO\",\"none\",\"RO\",\"NO\")",
    "{\"Cluj\":{\"a\":10.50,\"b\":4.00},\"Iasi\":{\"b\":3.25},\"Oslo\":{\"a\":1.00}}",
    "3,(3,1,2)",
    "10.50,(9,5),()",
    "(3,5,7),(),(4,5,6)",
