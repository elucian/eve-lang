# counter: a constant, private state, life cycle (D-068, D-085, D-087)
module counter is
  export (LIMIT, tick, count!);

  set LIMIT = 100 :Integer;
  new total = 0 :Integer;

  ** no result: changes the private state
  procedure tick() is
    let total += 1;
  return;

  ** stochastic: reads the private state, which can change
  function count!() => (@result: Integer) is
    let result := total;
  return;

  initialize
    print "counter: loaded";
  finalize
    print "counter: {total} ticks";
end counter;
