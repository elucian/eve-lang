# variation 1 of c01: the same module, another use case: only the constant, no call (D-133)
** spec: semantics/modules.md#import
driver c01_test1 is
  from lib use (counter);

  process main is
    expect counter.LIMIT == 100;
    print "limit: {counter.LIMIT}";
  return;
end c01_test1;
