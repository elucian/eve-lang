# variation 2 of c47: Rationals in collections: sort, min, max, sum, unique, contains, index_of, map and filter
** spec: semantics/types.md#rational
primary aspect c47_test2 is
  process main is
    new xs := (1\2, 1\3, 3\4, 1\6, 2\4);
    expect xs.sort() == (1\6, 1\3, 1\2, 1\2, 3\4);
    expect xs.sort(descending: True) == (3\4, 1\2, 1\2, 1\3, 1\6);
    expect xs.min() == 1\6;
    expect xs.max() == 3\4;
    expect xs.sum() == 9\4;
    expect xs.unique() == (1\2, 1\3, 3\4, 1\6);
    expect xs.contains(2\6);
    expect not xs.contains(1\5);
    expect xs.index_of(3\4) == 3;
    expect xs.map((x) => (x * 2)) == (1, 2\3, 3\2, 1\3, 1);
    expect xs.filter((x) => (x > 1\3)) == (1\2, 3\4, 1\2);
    expect xs.reduce(0, (a, x) => (a + x)) == 9\4;
    expect (1, 1\2, 0.25).sort() == (0.25, 1\2, 1);
    expect (1\2, 1\2, 1\2).sum() == 3\2;
    expect (3, 1\2).max() == 3;
    expect ().sum() == 0;
    new m := {1\2: "half", 1\3: "third"};
    expect m.get(2\4) == "half";
    expect m.get(3\9) == "third";
    expect m.has(1\2);
    new ys := (3\4, 1\4);
    expect ys.sum() == 1;
    print xs.sort(), xs.sum();
    print m;
  return;
end c47_test2;
/*@expect
{
  "stdout": ["(1\\6,1\\3,1\\2,1\\2,3\\4),9\\4", "{1\\3:\"third\",1\\2:\"half\"}"]
}
*/
