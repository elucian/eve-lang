# the type Rational: exact + - * / ^, mixing with Integer and Real, comparison, compound assignment, errors
** spec: semantics/types.md#rational
primary aspect c47_rational_arithmetic is
  function code_of_div() => (@r :Integer) is
    new x := 1\2 / 0\3;
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_int_div() => (@r :Integer) is
    new q := 1\2;
    new x := q / 0;
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_overflow() => (@r :Integer) is
    new big := 4611686018427387904\1;
    new x := big + big;
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_mul_overflow() => (@r :Integer) is
    new big := 3037000500\1;
    new x := big * big;
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_zero_power() => (@r :Integer) is
    new z := 0\1;
    new x := z ^ -1;
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_fractional_power() => (@r :Integer) is
    new q := 1\2;
    new x := q ^ (1\2);
    let r := 0;
  recover
    let r := $error.code;
  return;

  process main is
    expect 1\2 + 1\3 == 5\6;
    expect 1\2 - 1\3 == 1\6;
    expect 1\3 - 1\2 == -1\6;
    expect 2\3 * 3\4 == 1\2;
    expect (1\2) / (1\4) == 2;
    expect 3\4 / 3 == 1\4;
    expect 1\3 + 1\3 + 1\3 == 1;
    expect 1\10 + 2\10 == 3\10;
    expect 1\3 * 3 == 1;
    expect 3 * 1\3 == 1;
    expect 1 + 1\2 == 3\2;
    expect 1\2 + 1 == 3\2;
    expect 2 - 1\2 == 3\2;
    expect 1 - 1\2 == 1\2;
    expect 3 / (1\2) == 6;
    expect (1\2) ^ 3 == 1\8;
    expect (2\3) ^ 0 == 1;
    expect (2\3) ^ -2 == 9\4;
    expect (-2\3) ^ 3 == -8\27;
    expect (-2\3) ^ 2 == 4\9;
    expect 1\2 + 0.25 == 0.75;
    expect 0.25 + 1\2 == 0.75;
    expect 1\2 * 4.0 == 2.0;
    expect 1\4 / 0.5 == 0.5;
    expect type(1\2 + 0.25) == Real;
    expect type(1\2 + 1) == Rational;
    expect type(1\2 * 2) == Rational;
    expect type(1\2 + 1\2) == Rational;
    expect 1\3 < 1\2;
    expect 1\2 > 1\3;
    expect 1\2 <= 1\2;
    expect 1\2 >= 1\2;
    expect -1\2 < 1\3;
    expect -1\2 < -1\3;
    expect -1\3 > -1\2;
    expect 7\2 > 3;
    expect 7\2 < 4;
    expect 3 < 7\2;
    expect 1\3 < 0.5;
    expect 0.3 < 1\3;
    expect 1\2 == 0.5;
    expect 1\3 + 2\3 == 1;
    expect 2\4 + 1\4 == 3\4;
    new acc := 0\1;
    for k in (1..20) do
      let acc := acc + 1\1 / k;
    done;
    expect acc == 55835135\15519504;
    new p := 1\1;
    for k in (1..15) do
      let p := p * (k + 1) / k;
    done;
    expect p == 16;
    new t := 1\2;
    let t += 1\3;
    expect t == 5\6;
    let t -= 1\6;
    expect t == 2\3;
    let t *= 3\4;
    expect t == 1\2;
    let t /= 1\8;
    expect t == 4;
    expect code_of_div() == $err_divide;
    expect code_of_int_div() == $err_divide;
    expect code_of_overflow() == $err_overflow;
    expect code_of_mul_overflow() == $err_overflow;
    expect code_of_zero_power() == $err_divide;
    expect code_of_fractional_power() == $err_argument;
    print 1\2 + 1\3, 1\2 - 1\3, 2\3 * 3\4, 3\4 / 3;
    print (2\3) ^ -2;
    print 1\2 + 0.25;
    print acc;
  return;
end c47_rational_arithmetic;
/*@expect
{
  "stdout": ["5\\6,1\\6,1\\2,1\\4", "9\\4", "0.75", "55835135\\15519504"]
}
*/
