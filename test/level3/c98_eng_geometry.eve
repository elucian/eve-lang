# eng.geometry: points, polygons, triangles, circles, the convex hull and the crossing of two segments
** spec: library/engineering.md#module-geometry
primary aspect c98_eng_geometry is
  from lib/eng use (geometry);

  function code_of_polygon() => (@r :Integer) is
    new x := geometry.polygon_area(([0, 0], [1, 1]));
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_triangle() => (@r :Integer) is
    new x := geometry.triangle_area(1, 2, 3);
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_of_radius() => (@r :Integer) is
    new x := geometry.circle_area(-1);
    let r := 0;
  recover
    let r := $error.code;
  return;

  process main is
    new square := ([0, 0], [4, 0], [4, 3], [0, 3]);
    print geometry.distance([0, 0], [3, 4]), geometry.midpoint([0, 0], [3, 4]), round(geometry.angle([0, 0], [1, 1]) * 1000000);
    print geometry.polygon_area(square), geometry.perimeter(square), geometry.centroid(square), geometry.polygon_area(([0, 0], [0, 3], [4, 3], [4, 0]));
    print geometry.contains(square, [2, 1]), geometry.contains(square, [5, 1]), geometry.contains(square, [4, 1]), geometry.contains(([0, 0], [4, 0], [0, 4]), [3, 3]);
    print geometry.triangle_area(3, 4, 5), round(geometry.circle_area(1) * 1000000), round(geometry.circumference(2) * 1000000);
    print geometry.hull(([0, 0], [1, 1], [2, 2], [2, 0], [0, 2], [1, 0])), geometry.hull(([3, 1], [1, 1]));
    print geometry.segments_cross([0, 0], [2, 2], [0, 2], [2, 0]), geometry.segments_cross([0, 0], [1, 1], [2, 2], [3, 3]), geometry.segments_cross([0, 0], [2, 0], [1, 0], [1, 5]);
    print code_of_polygon(), code_of_triangle(), code_of_radius();
  return;
end c98_eng_geometry;
