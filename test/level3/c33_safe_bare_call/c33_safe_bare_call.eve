# a safe module can not call an unsafe module, also by a bare name from m(*) (D-129)
** spec: semantics/modules.md#safe-and-unsafe-modules
driver c33_safe_bare_call is
  from lib use (calm);

  process main is
    print "never";
  return;
end c33_safe_bare_call;
