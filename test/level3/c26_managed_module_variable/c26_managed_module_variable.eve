# a managed module is rejected when it has a variable that is not atomic (D-129)
** spec: semantics/modules.md#managed-and-direct-modules
driver c26_managed_module_variable is
  from lib use (shared);

  process main is
    print "never";
  return;
end c26_managed_module_variable;
