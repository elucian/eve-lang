# a managed module is accepted when every variable is Atomic(:T)
** spec: semantics/modules.md#managed-and-direct-modules
primary aspect c29_managed_module_atomic is
  from lib use (hits);

  process main is
    hits.record();
    hits.record();
    print "hits: {hits.total!()}";
  return;
end c29_managed_module_atomic;
