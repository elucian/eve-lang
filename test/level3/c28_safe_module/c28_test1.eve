# variation 1 of c28: a safe module under an alias (D-133)
** spec: semantics/modules.md#safe-and-unsafe-modules
driver c28_test1 is
  from lib use (pure as p);

  process main is
    expect p.FACTOR == 2;
    print "twice 21: {p.twice(21)}";
  return;
end c28_test1;
