# a class hosts only methods: a procedure in a class body is a compile error
** spec: syntax/declarations.md#classes-and-objects
primary aspect c15_procedure_in_class is
  class Counter = {n: Integer} <: Object is
    procedure reset() is           ** compile error: a class can't host a procedure
      print "reset";
    return;
  end Counter;

  process main is
    print "never";
  return;
end c15_procedure_in_class;
