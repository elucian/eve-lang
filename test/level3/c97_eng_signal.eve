# eng.signal: convolution, the discrete Fourier transform and its inverse, magnitudes and frequencies
** spec: library/engineering.md#module-signal
primary aspect c97_eng_signal is
  from lib/eng use (signal);

  function code_of_empty() => (@r :Integer) is
    new x := signal.dft(());
    let r := 0;
  recover
    let r := $error.code;
  return;

  process main is
    print signal.convolve((1, 2, 3), (0, 1, 0.5));
    new s := signal.dft((1, 0, -1, 0));
    new m := signal.magnitudes(s);
    print round(m[1] * 1000000), round(m[2] * 1000000), round(m[3] * 1000000), round(m[4] * 1000000);
    new back := signal.idft(s);
    print round(back[1] * 1000000), round(back[2] * 1000000), round(back[3] * 1000000), round(back[4] * 1000000);
    print signal.frequencies(4, 8);
    new flat := signal.magnitudes(signal.dft((1, 1, 1, 1)));
    print round(flat[1] * 1000000), round(flat[2] * 1000000), round(flat[3] * 1000000), round(flat[4] * 1000000);
    print code_of_empty();
  return;
end c97_eng_signal;
