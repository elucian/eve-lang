# math library: vectors and matrices (math.md)
** spec: library/math.md#module-linear
primary aspect a113_math_linear is
  from lib/math use (linear);

  function code_shape() => (@r :Integer) is
    new x := linear.dot((1, 2), (1, 2, 3));
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_singular() => (@r :Integer) is
    new x := linear.inverse(((1, 2), (2, 4)));
    let r := 0;
  recover
    let r := $error.code;
  return;
  function code_cross() => (@r :Integer) is
    new x := linear.cross((1, 2), (3, 4));
    let r := 0;
  recover
    let r := $error.code;
  return;

  process main is
    expect linear.dot((1, 2, 3), (4, 5, 6)) == 32;
    expect linear.cross((1, 0, 0), (0, 1, 0)) == (0, 0, 1);
    expect linear.norm((3, 4)) == 5;
    expect linear.scale((1, 2), 3) == (3, 6);
    expect linear.scale(((1, 2), (3, 4)), 2) == ((2, 4), (6, 8));
    expect linear.add((1, 2), (3, 4)) == (4, 6);
    expect linear.subtract(((5, 5), (5, 5)), ((1, 2), (3, 4))) == ((4, 3), (2, 1));
    expect linear.transpose(((1, 2, 3), (4, 5, 6))) == ((1, 4), (2, 5), (3, 6));
    expect linear.matmul(((1, 2), (3, 4)), ((5, 6), (7, 8))) == ((19, 22), (43, 50));
    expect linear.matvec(((1, 2), (3, 4)), (1, 1)) == (3, 7);
    expect linear.identity(2) == ((1, 0), (0, 1));
    expect linear.trace(((1, 2), (3, 4))) == 5;
    expect linear.det(((1, 2), (3, 4))) == -2;
    expect linear.det(((2, 0), (0, 3))) == 6;
    expect linear.inverse(((2, 0), (0, 4))) == ((0.5, 0), (0, 0.25));
    expect linear.solve(((2, 1), (1, -1)), (5, 1)) == (2, 1);
    expect code_shape() == $err_argument;
    expect code_singular() == $err_argument;
    expect code_cross() == $err_argument;
    print linear.solve(((2, 1), (1, -1)), (5, 1));
  return;
end a113_math_linear;
