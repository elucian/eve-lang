# an error jumps to recover; reaching the end of recover handles the error
** spec: semantics/errors.md#recover
primary aspect a31_recover is
  process main is
    print "work";
    raise "boom";
    print "never";
  recover
    print "caught: {$error.message}";
  return;
end a31_recover;
/*@expect
{
  "stdout": [
    "work",
    "caught: boom"
  ]
}
*/
