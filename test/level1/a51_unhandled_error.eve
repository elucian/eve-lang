# an error without recover ends the process with the exit code 4, after finalize (D-081)
** spec: semantics/errors.md#ending-the-process
driver a51_unhandled_error is
  process main is
    print "work";
    raise "boom";
  finalize
    print "finalize";
  return;
end a51_unhandled_error;
/*@expect
{
  "exit": 4,
  "stdout": [
    "work",
    "finalize"
  ],
  "stderr": [
    "boom"
  ]
}
*/
