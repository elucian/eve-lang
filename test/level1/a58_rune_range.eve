# a range of runes: ('a'..'c') visits the code points in order (from demo/symbol_range.eve, D-099)
** spec: syntax/expressions.md#ranges
driver a58_rune_range is
  process main is
    expect '0' in ('0'..'9');
    expect 'X' in ('A'..'Z');
    expect not ('x' in ('A'..'Z'));

    for d in ('a'..'c') do
      for n in ('1'..'3') do
        write d, n;
        write ',' if n < '3';
      done;
      print;
    done;
  return;
end a58_rune_range;
