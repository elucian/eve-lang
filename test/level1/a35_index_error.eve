# index 0 is an error: indexes start at 1 (D-021)
** spec: syntax/expressions.md#index-slice-member
driver a35_index_error is
  process main is
    new a := (1, 2, 3);
    new x := a[0];
    print "never";
  recover
    print "caught index error";
  return;
end a35_index_error;
