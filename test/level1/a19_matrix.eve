# matrix: two indexes, last index, absolute index, all elements [*] (D-058)
driver a19_matrix is
  process main is
    let m := [[1, 2, 3],
              [4, 5, 6]];
    expect m[1, 1] == 1;
    expect m[2, 3] == 6;
    expect m[1, $] == 3;
    expect m[$, 1] == 4;
    expect m[$, $] == 6;
    m[2, 1] := 40;
    expect m[2, 1] == 40;

    ** one absolute index counts the elements row by row
    expect m[3] == 3;
    expect m[5] == 5;

    ** [*] selects a whole dimension
    let g :[2, 2]Integer;
    g[*] := 1;
    expect g == [[1, 1], [1, 1]];
    g[1][*] := 5;                ** the first row
    expect g == [[5, 5], [1, 1]];

    ** a matrix builder uses two generators
    let t :[3, 3]Integer;
    t := [x * y | (x, y) in (1..3) >< (1..3)];
    expect t[3, 3] == 9;
    expect t[2, 3] == 6;
  return;
end a19_matrix;
