# := shares a collection or an object, :: makes a deep copy, native values are always copied (D-049)
** spec: syntax/declarations.md#variables-and-constants
driver a23_clone_view is
  process main is
    new x := 1;
    new y := x;
    let y += 1;
    expect x == 1;               ** a native value is copied

    new a := (1, 2, 3);
    new b := a;                  ** shares the reference
    let b <+ 4;
    expect a == (1, 2, 3, 4);
    expect b is a;

    new c :: a;                  ** a new list
    let c <+ 5;
    expect a == (1, 2, 3, 4);
    expect c == (1, 2, 3, 4, 5);
    expect c is not a;

    new p := {x: 1};
    new q := p;
    let q.x := 2;
    expect p.x == 2;
    new r :: p;
    let r.x := 3;
    expect p.x == 2;
  return;
end a23_clone_view;
