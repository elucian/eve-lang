# placeholders {name} and {name % format}: a name, a literal or a simple expression, written by its type; \{ \} are literal braces; {U+H} Unicode (D-096, D-102, formats are a draft)
** spec: lexical/lexical.md#string
driver a11_interpolation is
  process main is
    new name := "Eve";
    new n := 42;
    new pi := 3.14159;
    new ok := True;
    new sum := 1 + 2;            ** an expression goes in a variable first
    new big := 1234567;
    print "name = {name}";
    print "n = {n}";
    print "ok = {ok}";
    print "sum = {sum}";
    print "alpha = {U+03B1}";
    print "braces = \{x\}";
    print "both = \{{n}\}";             ** an escaped brace next to a placeholder
    new lst := (10, 20, 30);
    print "second = {lst[2]}, last = {lst[-1]}, part = {lst[2..3]}";   ** brackets select a member (Q-033a)
    new m := {"a": 1, "b": 2};
    print "b = {m["b"]}";                ** a quoted key: no escape inside the braces
    print "literals: {399} {"test"} {(1,2,3)} {'x'} {True} {"a b"}";   ** any literal; its quotes are not escaped
    print "expressions: {n + 1} {n * 2 - 1} {name.length()} {n > 40} {name + "!"} {((n + 1) % 5)}";   ** D-121

    ** formats: width, fill, alignment
    print "n = {n % i5}|{n % 0>i5}|{n % <i5}|";
    print "pi = {pi % f8.2}|";
    print "big = {big % ,i9}";
    print "name = {name % *^9}|{name % >6}|{name % .2}|";
    print "ok = {ok % yn} {ok % 01}";
  return;
end a11_interpolation;
