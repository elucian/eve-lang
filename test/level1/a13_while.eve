# while loop with a header, break and else (D-030, D-033, D-034); `then` was removed, the code goes after `done;`
** spec: semantics/control.md#loops
driver a13_while is
  process main is
    ** the header declares i: it lives in the loop; sum is declared in the process
    new sum := 0;
    loop
      new i := 1;
    while i <= 5 do
      let sum += i;
      let i += 1;
    done;
    print "sum = {sum}";

    ** an infinite loop is left with break
    new n := 0;
    while True do
      let n += 1;
      break if n >= 3;
    done;
    expect n == 3;

    ** else runs only when the condition is false the first time
    while False do
      print "never";
    else
      print "empty";
    done;

    ** the statements after done run every time the loop ends, also after break
    new k := 0;
    while k < 10 do
      let k += 1;
      break if k == 2;
    done;
    print "k = {k}";

    ** a label closes the loop: done label;
    new j := 0;
    count: loop
    while j < 3 do
      let j += 1;
    done count;
    expect j == 3;
  return;
end a13_while;
/*@expect
{
  "stdout": [
    "sum = 15",
    "empty",
    "k = 2"
  ]
}
*/
