# method is a contextual word: a keyword where a declaration is expected, a name everywhere else (G-6, D-116)
** spec: lexical/keywords.json
primary aspect a91_method_as_name is
  function describe(method: String, params: Integer) => (@r: String) is
    let r := "{method}/{params}";
  return;

  process main is
    new method := "GET";
    print describe(method, 2);
    let method := "POST";
    print method;
  return;
end a91_method_as_name;
/*@expect
{
  "stdout": ["GET/2", "POST"]
}
*/
