# jobs: retry runs a failed job again, resume goes on after it (D-020, D-034)
** spec: semantics/control.md#job, semantics/errors.md#recover
driver a34_jobs is
  process main is
    new tries := 0;

    c1: job
    do
      let tries += 1;
      raise "fail" if tries < 3;
      print "c1 passed after {tries} tries";
    done c1;

    c2: job
    do
      raise "bad";
    done c2;

    print "after the jobs";
  recover
    if $error.job == "c1" and tries < 3 do
      retry;
    else if $error.job == "c2" do
      print "c2 failed: {$error.message}";
      resume;
    else
      abort;
    done;
  return;
end a34_jobs;
/*@expect
{
  "stdout": [
    "c1 passed after 3 tries",
    "c2 failed: bad",
    "after the jobs"
  ]
}
*/
