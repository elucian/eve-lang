# HashMap: a sorted map of key:value pairs (D-058)
driver a21_hashmap is
  process main is
    let h := {'a': 1, 'b': 2};
    expect h['a'] == 1;
    expect h['b'] == 2;
    expect 'a' in h;
    expect 'z' not in h;

    ** an assignment to a missing key creates the element
    h['c'] := 3;
    expect h['c'] == 3;
    h['a'] += 10;
    expect h['a'] == 11;

    ** numeric keys
    let n := {1: "one", 2: "two"};
    expect n[2] == "two";
    expect 1 in n;

    ** iteration visits the keys in order
    let keys := "";
    for (k: v) in h do
      keys += k;
    done;
    expect keys == "abc";
  return;
end a21_hashmap;
