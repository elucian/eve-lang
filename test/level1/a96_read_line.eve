# read(prompt) reads a line from the standard input and gives it as a String; at the end of the input it gives null
** spec: syntax/statements.md#calls
primary aspect a96_read_line is
  process main is
    new name := read("name: ");
    print "hello {name}";
    new line := read();
    print "[{line}]";
    new rest := read();
    print rest == null;
  return;
end a96_read_line;
/*@expect
{
  "stdin": ["Eve", "second line"],
  "stdout": ["name: hello Eve", "[second line]", "True"]
}
*/
