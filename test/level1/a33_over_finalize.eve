# over skips recover but runs finalize: a clean exit never skips cleanup
** spec: semantics/errors.md#finalize
primary aspect a33_over_finalize is
  process main is
    print "work";
    over;
  finalize
    print "finalize";
  return;
end a33_over_finalize;
