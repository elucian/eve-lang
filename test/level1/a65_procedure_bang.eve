# a procedure is made for side effects and is never deterministic: it never ends with ! (D-101)
** spec: syntax/declarations.md#functions-and-procedures
driver a65_procedure_bang is
  procedure tick!() is              ** compile error: a procedure has no !
    print "tick";
  return;

  process main is
    tick!();
  return;
end a65_procedure_bang;
