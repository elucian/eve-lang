# DataSet: sorted unique values, union, intersection, difference (D-058)
** spec: semantics/types.md#composite-types
driver a20_dataset is
  process main is
    new a := {3, 1, 2, 3};
    expect a == {1, 2, 3};       ** no duplicates
    expect 2 in a;
    expect 5 not in a;

    expect ({1, 2, 3} || {3, 4}) == {1, 2, 3, 4};
    expect ({1, 2, 3} && {2, 3, 4}) == {2, 3};
    expect ({1, 2, 3, 4} - {3, 4, 5}) == {1, 2};

    let a += {9};
    expect a == {1, 2, 3, 9};
    let a -= {1, 9};
    expect a == {2, 3};
    let a := {};
    expect a == {};

    ** a list gives a DataSet
    expect ({} || (1, 2, 1, 2, 3)) == {1, 2, 3};
    expect ((1, 2, 3, 4) && (2, 3, 4, 5)) == {2, 3, 4};

    ** a builder
    expect {x * x | x in (2..6)} == {4, 9, 16, 25, 36};

    ** a DataSet prints in order
    new s := {3, 1, 2};
    print s;
  return;
end a20_dataset;
