# finalize runs after the process ends normally, and after recover (D-020)
** spec: semantics/errors.md#finalize
driver a32_finalize is
  process main is
    print "work";
    raise "boom";
  recover
    print "recover";
  finalize
    print "finalize";
  return;
end a32_finalize;
/*@expect
{
  "stdout": [
    "work",
    "recover",
    "finalize"
  ]
}
*/
