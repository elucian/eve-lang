# where a name lives: the aspect (hoisted, shared with its functions), a process, a loop (one scope for the header and all the cycles), an if (no scope)
** spec: semantics/scopes.md#blocks
primary aspect a101_scopes is
  new shared := 10;
  function show() => (@r :Integer) is
    let r := shared + later;
  return;
  new later := 1;
  process main is
    new y := 0;
    for i in (1, 2) do
      let y := i * 10;
      print y;
    done;
    new n := 0;
    loop new steps := 100;
    while n < 2 do
      let steps := steps + 1;
      let n := n + 1;
      print steps;
    done;
    print show();
    if n == 2 do
      new inside := 7;
    done;
    print inside;
  return;
end a101_scopes;
/*@expect
{
  "stdout": ["10", "20", "101", "102", "11", "7"]
}
*/
