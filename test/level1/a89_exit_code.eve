# over <code>; ends the process with the exit code, finalize still runs (G-2)
** spec: semantics/errors.md#ending-the-process
primary aspect a89_exit_code is
  procedure stop_here() is
    over 7;
  return;

  process main is
    print "start";
    stop_here();
    print "never";
  finalize
    print "cleanup";
  return;
end a89_exit_code;
/*@expect
{
  "stdout": ["start", "cleanup"],
  "exit": 7
}
*/
