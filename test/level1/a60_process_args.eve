# the process receives the command-line arguments; a vararg collects them (from demo/method_call.eve and demo/test_args.eve)
** spec: syntax/declarations.md#scripts
primary aspect a60_process_args is

  process main(*args) is
    expect args is List;
    panic if args.count() == 0;  ** early interruption: no argument
    for arg in args do
      print arg;
    done;

  return;
end a60_process_args;
/*@expect
{
  "args": ["one", "two"],
  "stdout": ["one", "two"]
}
*/
