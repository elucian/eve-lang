# an Ordinal is a set of named integer values; the first value is 0 (D-058)
driver a16_ordinal is
  class Color = {Red, Green, Blue} <: Ordinal;
  class Level = {Low:10, High} <: Ordinal;
  class Shade = {dark, light} <: Ordinal;

  process main is
    ** names that start with a capital letter need no qualifier
    expect Red == 0;
    expect Green == 1;
    expect Blue == 2;
    expect Low == 10;
    expect High == 11;

    ** other names need the type name
    expect Shade.dark == 0;
    expect Shade.light == 1;

    let c := Green;
    match c
      when Red do
        print "red";
      when (Green, Blue) do
        print "green or blue";
      when other do
        print "unknown";
    done;
  return;
end a16_ordinal;
