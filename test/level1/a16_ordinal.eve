# an Ordinal is a set of named integer values; the first value is 1 unless one is given (Q-029, D-096)
** spec: semantics/types.md#composite-types
driver a16_ordinal is
  class Color = {Red, Green, Blue} <: Ordinal;
  class Level = {Low:10, High} <: Ordinal;
  class Shade = {dark, light} <: Ordinal;

  process main is
    ** names that start with a capital letter need no qualifier
    expect Red == 1;
    expect Green == 2;
    expect Blue == 3;
    expect Low == 10;
    expect High == 11;

    ** other names need the type name
    expect Shade.dark == 1;
    expect Shade.light == 2;

    new c := Green;
    match c
      when Red do
        print "red";
      when (Green, Blue) do
        print "green or blue";
      when other do
        print "unknown";
    done;
  return;
end a16_ordinal;
