# Object: unquoted keys make an object, quoted or numeric keys make a DataMap (D-058, D-080)
** spec: semantics/types.md#composite-types
driver a22_object is
  process main is
    new p := {x: 1.5, y: 2};
    expect p.x == 1.5;
    expect p.y == 2;
    let p.x := 3;
    expect p.x == 3;

    ** == compares all the attributes, is compares the object
    ** (an attribute can't be added from outside: see a55)
    new q := {x: 3, y: 2};
    expect p == q;
    expect p is not q;
  return;
end a22_object;
