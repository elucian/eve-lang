# loop tested at the end: loop … do … repeat [while c]; and skip (D-074)
** spec: semantics/control.md#loops
driver a39_repeat is
  process main is
    ** the body runs at least once, the condition is tested at the end
    new n := 10;
    loop do
      let n += 1;
    repeat while n < 5;
    expect n == 11;

    ** the header declares variables that survive all the cycles
    new s := "";
    loop
      new i := 0;
    do
      let i += 1;
      let s <+ "{i}";
    repeat while i < 3;
    expect s == "123";

    ** a bare repeat loops until break
    new k := 0;
    loop do
      let k += 1;
      break if k == 4;
    repeat;
    expect k == 4;

    ** skip jumps to the test at the end, which still runs
    new odd := "";
    loop
      new j := 0;
    do
      let j += 1;
      skip if j % 2 == 0;
      let odd <+ "{j}";
    repeat while j < 6;
    expect odd == "135";

    ** in a while loop skip goes back to the condition
    new w := "";
    new m := 0;
    while m < 5 do
      let m += 1;
      skip if m == 3;
      let w <+ "{m}";
    done;
    expect w == "1245";
    print "repeat ok";
  return;
end a39_repeat;
