# for loop over ranges and collections (D-022)
** spec: semantics/control.md#loops, syntax/expressions.md#ranges
driver a14_for is
  process main is
    new s := "";
    for i in (1..5) do
      let s <+ "{i}";
    done;
    expect s == "12345";

    ** the four range forms
    new a := "";
    for i in (1..<5) do
      let a <+ "{i}";
    done;
    expect a == "1234";
    new b := "";
    for i in (1>..5) do
      let b <+ "{i}";
    done;
    expect b == "2345";
    new c := "";
    for i in (1>..<5) do
      let c <+ "{i}";
    done;
    expect c == "234";

    ** the step follows the range
    new d := "";
    for i in (1..9)(4) do
      let d <+ "{i}";
    done;
    expect d == "159";

    ** a list is iterable
    new u := "";
    for e in ('a', 'b', 'c') do
      let u <+ e;
    done;
    expect u == "abc";

    ** skip goes to the next element, break leaves the loop
    new v := "";
    for i in (1..5) do
      skip if i % 2 == 0;
      let v <+ "{i}";
    done;
    expect v == "135";
    new w := "";
    for i in (1..10) do
      break if i > 3;
      let w <+ "{i}";
    done;
    expect w == "123";

    ** the control variable is visible in then
    for i in (1..3) do
      print "i = {i}";
    then
      print "last index {i}";
    done;

    ** a labeled loop: break and skip may name an outer loop
    new pairs := 0;
    outer: loop
    for i in (1..3) do
      for j in (1..3) do
        skip outer if j > i;
        let pairs += 1;
      done;
    done outer;
    expect pairs == 6;
  return;
end a14_for;
