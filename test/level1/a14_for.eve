# for loop over ranges and collections (D-022)
driver a14_for is
  process main is
    let s := "";
    for i in (1..5) do
      s += "\#{i}";
    done;
    expect s == "12345";

    ** the four range forms
    let a := "";
    for i in (1..<5) do
      a += "\#{i}";
    done;
    expect a == "1234";
    let b := "";
    for i in (1>..5) do
      b += "\#{i}";
    done;
    expect b == "2345";
    let c := "";
    for i in (1>..<5) do
      c += "\#{i}";
    done;
    expect c == "234";

    ** the step follows the range
    let d := "";
    for i in (1..9)(4) do
      d += "\#{i}";
    done;
    expect d == "159";

    ** a list is iterable
    let u := "";
    for e in ('a', 'b', 'c') do
      u += e;
    done;
    expect u == "abc";

    ** next advances the index, break leaves the loop
    let v := "";
    for i in (1..5) do
      next if i % 2 == 0;
      v += "\#{i}";
    done;
    expect v == "135";
    let w := "";
    for i in (1..10) do
      break if i > 3;
      w += "\#{i}";
    done;
    expect w == "123";

    ** the control variable is visible in then
    for i in (1..3) do
      print "i = \#{i}";
    then
      print "last index \#{i}";
    done;
  return;
end a14_for;
