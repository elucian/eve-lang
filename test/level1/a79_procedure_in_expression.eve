# a procedure has no value: it can't be used in an expression (D-100)
** spec: syntax/declarations.md#functions-and-procedures
driver a79_procedure_in_expression is
  procedure hello is
    print "hello";
  return;

  process main is
    new v := hello();            ** compile error: a procedure returns nothing
  return;
end a79_procedure_in_expression;
