# exit ends the process without error and runs finalize (D-020)
** spec: syntax/statements.md#interruptions
driver a50_exit is
  process main is
    print "work";
    exit;
    print "never";
  finalize
    print "finalize";
  return;
end a50_exit;
/*@expect
{
  "stdout": [
    "work",
    "finalize"
  ]
}
*/
