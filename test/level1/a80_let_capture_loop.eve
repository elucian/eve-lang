# in a loop a capture creates its name once: the next turns assign it, they do not create it again (D-104)
** spec: syntax/statements.md#let
driver a80_let_capture_loop is
  process main is
    new lst := (1, 2, 3);
    new total := 0;
    while lst.count() > 0 do
      let lst -> e;              ** e is created at the first turn, assigned at the others
      let total += e;
    done;
    expect total == 6;
    expect e == 1;               ** the last value captured
    print total;
  return;
end a80_let_capture_loop;
/*@expect
{
  "stdout": ["6"]
}
