# level 1 performance: exact fractions, the type Rational
** perf: Rational arithmetic: a telescoping sum of 200,000 fractions, 20,000 runs of Newton's square root of 2 in fractions, 100,000 comparisons
primary aspect p1e_rational is
  process main is
    new total := 0\1;
    for k in (1..200000) do
      let total := total + 1\1 / (k * (k + 1));
    done;
    expect total == 200000\200001;
    new last := 1\1;
    new x := 1\1;
    for r in (1..20000) do
      let x := 1\1;
      for step in (1..5) do
        let x := (x + 2\1 / x) / 2\1;
      done;
      let last := x;
    done;
    expect last == 886731088897\627013566048;
    new below := 0;
    new probe := 1\3;
    for k in (1..100000) do
      if probe < 1\1 * k / (k + 1) do
        let below += 1;
      done;
    done;
    expect below == 100000;
    print total, last, below;
  return;
end p1e_rational;
