# level 5 performance: an Eve function called by SQLite on every row of a query (D-166)
** perf: 20,000 rows made in SQL, then a query that calls a sql function on each row, three times (60,000 calls)
driver p5a_sql_function is
  class Row = {n: Integer, total: Integer} <: Record;

  sql function weight(x: Integer) => (@r: Integer) is
    let r := x * 3 + 1;
  return;

  process main is
    new db := database.connect("bench");
    new dropped := db.execute!("drop table if exists t");
    new made := db.execute!("create table t (n integer primary key)");
    new rows := db.execute!("with recursive c(n) as (select 1 union all select n + 1 from c where n < 20000) insert into t select n from c");
    new sum := 0;
    for k in (1..3) do
      new r := db.query_one!(:Row)("select count(*) as n, sum(weight(n)) as total from t");
      let sum += r.total;
    done;
    expect sum == 1800150000;
    print sum;
  return;
end p5a_sql_function;
