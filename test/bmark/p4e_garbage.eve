# level 4 performance: a loop that makes short-lived strings and lists (memory churn)
** perf: 200,000 iterations that each build a string and a list and drop them; watch the peak memory
primary aspect p4e_garbage is
  process main is
    new total := 0;
    new s := "";
    new parts := ();
    for i in (1..200000) do
      let s := "item {i}";
      let parts := (i, i + 1, i + 2);
      let total += s.length() + parts.length();
    done;
    expect total == 2688895;
    print total;
  return;
end p4e_garbage;
