# level 1 performance: the offset of a time zone at an instant, from the meta database
** perf: zone.offset for 60,000 instants (1900 to 2100) in three zones: Europe/Bucharest, America/New_York and Australia/Lord_Howe
primary aspect p1i_zone_offsets is
  from lib/meta use (zone);

  process main is
    new names := ("Europe/Bucharest", "America/New_York", "Australia/Lord_Howe");
    new total := 0;
    new x := 0;
    new t := Instant.epoch;
    for z in (1..3) do
      let x := 123456789;
      for k in (1..20000) do
        let x := (x * 1103515245 + 12345) % 2147483648;
        let t := Instant.epoch + 1s * (-2208988800 + (x * 2939) % 6311520000);
        let total += time.millis(zone.offset(names[z], t)) / 1000;
      done;
    done;
    print total;
  return;
end p1i_zone_offsets;
