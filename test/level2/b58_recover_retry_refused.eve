# retry and resume need a failed job: in the recover of a function they are a run-time error
** spec: semantics/errors.md#recover-in-a-function-procedure-or-method
primary aspect b58_recover_retry_refused is
  procedure flaky() is
    raise "boom";
  recover
    retry;
  return;

  process main is
    flaky();
  recover
    print "caller: {$error.message}";
  return;
end b58_recover_retry_refused;
/*@expect
{
