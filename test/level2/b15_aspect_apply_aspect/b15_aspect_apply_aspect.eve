# an aspect may apply another aspect, by its name (D-179, it was a compile error with D-066)
** spec: semantics/aspects.md#apply
primary aspect b15_aspect_apply_aspect is
  process main is
    print "main";
    apply outer();
  return;
end b15_aspect_apply_aspect;
/*@expect
{
  "stdout": [
    "main",
    "outer",
    "inner"
  ]
}
*/
