# variation 1 of b29: the default exponent, then both by name (D-133)
** spec: semantics/aspects.md#what-an-aspect-is
driver b29_test1 is
  process main is
    new r :Integer;
    apply power(3, out: @r);
    print r;
    apply power(base: 2, exp: 10, out: @r);
    print r;
  return;
end b29_test1;
/*@expect
{
  "stdout": [
    "9",
    "1024"
  ]
}
