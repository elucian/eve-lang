# finalize of an aspect runs when main ends, also by over; then the primary aspect goes on
** spec: semantics/aspects.md#errors-across-apply
primary aspect b26_aspect_finalize is
  process main is
    apply closing(False);
    apply closing(True);
    print "back";
  return;
end b26_aspect_finalize;
