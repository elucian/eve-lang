# exit in a procedure leaves only the procedure; the process goes on (D-111)
** spec: syntax/statements.md#interruptions
driver b35_exit_procedure is
  procedure check(n: Integer) is
    if n < 0 do
      print "negative";
      exit;
    done;
    print "positive";
  return;

  process main is
    check(-1);
    check(1);
    print "end";
  finalize
    print "finalize";
  return;
end b35_exit_procedure;
