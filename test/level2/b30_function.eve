# functions: result, named arguments, default values, several results (D-028, D-070, D-086, D-087)
** spec: syntax/declarations.md#functions-and-procedures
driver b30_function is
  function sum(a, b: Integer) => (@result: Integer) is
    let result := a + b;
  return;

  function greet(name: String, greeting = "Hello") => (@result: String) is
    let result := "{greeting}, {name}!";
  return;

  function divmod(a, b: Integer) => (@q: Integer, @r: Integer) is
    new t = a / b :Integer;
    let q := t;
    let r := a % b;
  return;

  function fact(n: Integer) => (@result: Integer) is
    if n <= 1 do
      let result := 1;
    else
      let result := n * fact(n - 1);
    done;
  return;

  process main is
    expect sum(1, 2) == 3;
    expect sum(b: 5, a: 1) == 6;
    expect greet("Eve") == "Hello, Eve!";
    expect greet("Eve", greeting: "Hi") == "Hi, Eve!";
    expect fact(5) == 120;
    new q, r := divmod(17, 5);
    expect q == 3 and r == 2;
    print sum(2, 4);
    print greet("World");
  return;
end b30_function;
