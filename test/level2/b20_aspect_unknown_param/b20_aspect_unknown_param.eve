# an argument named like no parameter is a check-time error (D-112)
** spec: semantics/aspects.md#arguments
driver b20_aspect_unknown_param is
  process main is
    print "never";
    apply greet("Eve", greetin: "Hi");
  return;
end b20_aspect_unknown_param;
/*@expect
{
  "syntax_error": true,
  "exit": 65,
  "note": "the parameter is greeting, not greetin"
}
*/
