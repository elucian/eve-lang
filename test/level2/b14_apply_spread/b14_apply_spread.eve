# spreading a list into positional arguments and a map into named arguments (D-072 i)
driver b14_apply_spread is
  process main is
    new xs := (2, 3);
    apply add3(1, *xs);
    new m := {'b': 20, 'c': 30};
    apply add3(a: 10, *m);
  return;
end b14_apply_spread;
/*@expect
{
  "stdout": [
    "6",
    "60"
  ],
  "note": "the keys of a spread map are symbols named like the parameters (Q-022 c)"
}
*/
