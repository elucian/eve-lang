# log_err and log_wrn write log files in the output folder out/ (D-057, D-114)
driver b09_log_files is
  process main is
    log_wrn("low memory");
    raise "disk full";
  recover
    log_err("{$error.message}");
    print "logged";
  return;
end b09_log_files;
