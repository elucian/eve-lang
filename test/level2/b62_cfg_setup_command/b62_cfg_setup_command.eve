# the REPL command setup checks a configuration file and keeps it for the next runs; a missing file is reported
** spec: semantics/variables.md#system-variables
primary aspect b62_cfg_setup_command is
  process main is
    print "unused";
  return;
end b62_cfg_setup_command;
