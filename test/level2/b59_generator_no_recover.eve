# a generator has no recover region: it is a compile error
** spec: semantics/errors.md#recover-in-a-function-procedure-or-method
primary aspect b59_generator_no_recover is
  generator count(n: Integer) => (@x: Integer) is
    yield n;
  recover
    pass;
  return;

  process main is
    print "never";
  return;
end b59_generator_no_recover;
/*@expect
{
  "syntax_error": true,
  "exit": 65
}
