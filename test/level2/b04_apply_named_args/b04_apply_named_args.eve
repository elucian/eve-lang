# apply with arguments by position, by name and with a default value (D-028, D-066)
driver b04_apply_named_args is
  process main is
    apply report("A");
    apply report(title: "B", width: 20);
    apply report("C", width: 5);
  return;
end b04_apply_named_args;
/*@expect
{
  "stdout": [
    "A: 10",
    "B: 20",
    "C: 5"
  ]
}
