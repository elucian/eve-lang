# a Secret is not a String: joining it to a text with + is a compile error (data-language.md#secrets, D-110)
** spec: library/data-language.md#secrets
driver e103_secret_join is
  process main is
    new s := Secret("hunter2");
    new t := "pw=" + s;
    print "not reached";
  return;
end e103_secret_join;
