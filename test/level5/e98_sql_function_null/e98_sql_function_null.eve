# SQL NULL maps only to a nullable type: a NULL for a parameter of type String stops the query with $err_sql
** spec: library/database.md#sql-functions
primary aspect e98_sql_function_null is
  class Person = {id: Integer, name: String} <: Record;

  sql function shout(s: String) => (@result: String) is
    let result := "hello {s}";
  return;

  process main is
    new shop := database.connect("shop");
    shop.script("sql/schema.sql");
    print shop.query_one!(:Person)("select id, shout(name) as name from people where id = 1").name;
    new all := shop.query!(:Person)("select id, shout(name) as name from people order by id");
    print "not reached";
  recover
    print $error.code == $err_sql;
    print $error.message;
  return;
end e98_sql_function_null;
