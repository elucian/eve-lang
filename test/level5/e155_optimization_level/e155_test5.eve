  "command": ["-O", "10", "-x", "e155_test5.eve"],
  "exit": 4,
  "stdout": ["338350,610,42,15,EVEDATATEST,3", "2.5,1"],
  "stderr": ["error 10: Index 5 is out of range 1..3"]
}
