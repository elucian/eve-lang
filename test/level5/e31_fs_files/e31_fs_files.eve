# fs writes, appends, reads lines and reports a missing file with the error code 20
** spec: library/data-language.md#files-and-paths
driver e31_fs_files is
  process main is
    fs.write("out/note.txt", "one\ntwo\n");
    expect fs.exists!("out/note.txt");
    for line in fs.lines!("out/note.txt") do
      print "> {line}";
    done;
    fs.append("out/note.txt", "three\n");
    new n := 0;
    for line in fs.lines!("out/note.txt") do
      let n += 1;
    done;
    print "lines: {n}";
    for l in fs.lines!("out/missing.txt") do
      print l;
    done;
  recover
    new c := $error.code;
    print "error: {c}";
  return;
end e31_fs_files;
