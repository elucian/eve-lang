# an aspect of the macro with the name of an aspect file of the project is a compile error
** spec: syntax/declarations.md#eve-macro-level-5

exclusive aspect worker is
  process main is
    print "macro worker";
  return;
end worker;

primary aspect e65_macro_aspect_conflict is
  process main is
    apply worker();
  return;
end e65_macro_aspect_conflict;
