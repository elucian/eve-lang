# Uuid: parsed from text in any case, with or without hyphens and braces; printed in lower case with hyphens; a version and 16 bytes
** spec: library/bytes.md#uuid
primary aspect e142_uuid_basics is
  process main is
    new u := Uuid.parse("550E8400E29B41D4A716446655440000");
    print u;
    print u.version();
    print u.bytes().length();
    expect Uuid.from_bytes(u.bytes()) == u;
    print uuid.namespace_dns;
    print uuid.namespace_dns.version();
    expect uuid.v4!() <> uuid.v4!();
    print uuid.v4!().version();
    print uuid.v7!().version();
    print uuid.v5(uuid.namespace_dns, "www.example.com");
    print uuid.v3(uuid.namespace_dns, "www.example.com");
    expect uuid.v5(uuid.namespace_dns, "www.example.com") == uuid.v5(uuid.namespace_dns, "www.example.com");
    print Uuid.from_bytes(Bytes.from_hex("00000000000000000000000000000000"));
    print Uuid.from_bytes(Bytes.from_hex("00000000000000000000000000000000")).version();
  return;
end e142_uuid_basics;
