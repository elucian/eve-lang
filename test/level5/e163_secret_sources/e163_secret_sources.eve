# a secret comes from the variable EVE_SECRET_<NAME>, else from the file named by EVE_SECRET_<NAME>_FILE (its last line ending cut); the variable wins; a missing file is $err_file; the value never prints
** spec: library/data-language.md#secrets
primary aspect e163_secret_sources is
  process main is
    fs.write("out/e163/db_pass.txt", "file-pass\n");
    new a := secret.get("api_token");
    new b := secret.get("db_pass");
    new c := secret.get("both");
    print a;
    print "b={b}";
    print crypto.hmac_sha256(a, "msg");
    print crypto.hmac_sha256(b, "msg");
    print crypto.hmac_sha256(c, "msg");
    new d := secret.get("gone");
    print "not reached";
  recover
    print "code: {$error.code}";
    print $error.message.contains("file-pass");
  return;
end e163_secret_sources;
