# JSON Lines: the writer text is exact, the reader gives the records back
** spec: semantics/data-types.md#the-formats-in-detail
primary aspect e36_json_lines is
  class Item = {id: Integer, name: String, note: String?, price: Decimal} <: Record;

  process main is
    new rows := Table(:Item)();
    new a := {id: 1, name: "Ann", note: null, price: 12.50d} :Item;
    new b := {id: 2, name: "Smith, \"Bob\"", note: "x", price: 3d} :Item;
    let rows <+ a;
    let rows <+ b;
    json.write("out/items.jsonl", rows);
    for i in json.read!(:Item)("out/items.jsonl") do
      print "{i.id} {i.price}";
    done;
  return;
end e36_json_lines;
