# yield in a function is a compile error: only the body of a generator can yield
** spec: syntax/declarations.md#generators-level-5
primary aspect e25_yield_outside is
  function f() => (@r: Integer) is
    yield 1;
  return;

  process main is
    print f();
  return;
end e25_yield_outside;
/*@expect
{
  "syntax_error": true,
  "exit": 65,
  "contains": [
    "yield outside a generator"
  ]
}
*/
