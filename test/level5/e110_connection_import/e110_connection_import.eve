# import: a method of the connection that loads a file (CSV, TXT, JSON or DBF) as a new table
** spec: library/data-engines.md
primary aspect e110_connection_import is
  class Item = {id: Integer, name: String, price: Decimal?, day: String} <: Record;

  process main is
    new shop := database.connect("shop");
    shop.execute!("drop table if exists items");
    print shop.import("data/items.csv", "items");
    for i in shop.query!(:Item)("select id, name, price, day from items order by id") do
      print "{i.id} {i.name} {i.day}";
    done;
    print shop.query_one!(:Item)("select id, name, price, day from items where id = 3").price;
  return;
end e110_connection_import;
