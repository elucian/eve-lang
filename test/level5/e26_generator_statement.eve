# a generator called as a statement is a compile error: its values would be lost
** spec: syntax/declarations.md#generators-level-5
primary aspect e26_generator_statement is
  generator count_to(n: Integer) => (@x: Integer) is
    for i in (1..n) do
      yield i;
    done;
  return;

  process main is
    count_to(5);
  return;
end e26_generator_statement;
/*@expect
{
  "syntax_error": true,
  "exit": 65,
  "contains": [
    "called as a statement"
  ]
}
*/
