# a result of a function with another basic type than its declared result: a compile error before the run (F-LNG-16)
** spec: semantics/types.md#static-checks
primary aspect e160_test2 is
  function bad(x: Integer) => (@result: Integer) is
    let result := "text";
  return;
  process main is
    print bad(1);
  return;
end e160_test2;
