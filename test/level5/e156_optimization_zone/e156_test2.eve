# the zone functions give the same answers at optimization level 5 (the database is read in the background at the start, D-226) and at levels 0 and 1 (read at the first use, D-225)
** spec: semantics/variables.md#optimization-level
primary aspect e156_test2 is
  process main is
    new zone := time.zone("Europe/Bucharest");
    print time.at_zone(Instant.parse("2026-07-01T07:00:00Z"), zone);
    print time.zone("America/New_York");
    print time.at_zone(Instant.parse("2026-07-01T07:00:00Z"), time.zone("Asia/Kolkata"));
  return;
end e156_test2;
