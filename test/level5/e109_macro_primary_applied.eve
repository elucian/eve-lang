# in a macro, no aspect applies the primary aspect
** spec: syntax/declarations.md#eve-macro-level-5
exclusive aspect helper is
  process main is
    apply e109_macro_primary_applied();   ** compile error
  return;
end helper;

primary aspect e109_macro_primary_applied is
  process main is
    apply helper();
  return;
end e109_macro_primary_applied;
