        let ay := d;
      done;
      let sm := d.start_of("month");
      let sq := d.start_of("quarter");
      let sw := d.start_of("week");
      let sy := d.start_of("year");
      let em := d.end_of_month();
      let mb := time.months_between(d, e2);
      let days := d - time.date(1970, 1, 1);
      let line := "{d} {wd} {doy} {iw} {iy} {am} {ay} {sm} {sq} {sw} {sy} {em} {mb} {days}";
      if line <> expected[i] do
        print "differs at {i}: {line} expected {expected[i]}";
        let bad += 1;
      done;
    done;
    expect bad == 0;
    print 220 - bad;
  return;
end e125_date_table;
/*@expect
{
  "stdout": ["220"]
}
*/
