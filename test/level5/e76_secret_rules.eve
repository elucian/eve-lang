# a Secret prints as *** alone, in interpolation and in a collection (data-language.md#secrets); joining it to a text: e103
** spec: library/data-language.md#secrets
primary aspect e76_secret_rules is
  process main is
    new s := Secret("hunter2");
    print s;
    print "ok: {s}";
    new both := (1, s);
    print both;
  return;
end e76_secret_rules;
