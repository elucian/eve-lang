# a Secret is not turned into a String: joining it to a text is an error (data-language.md#secrets)
** spec: library/data-language.md#secrets
driver e76_secret_rules is
  process main is
    new s := Secret("hunter2");
    print "ok: {s}";
    new both := (1, s);
    print both;
    new t := "pw=" + s;
    print "not reached";
  recover
    print "error: a Secret is not a String";
  return;
end e76_secret_rules;
