# outside a job a record that is added or changed is written and committed at once, one statement at a time (database.md, transactions)
** spec: library/database.md#transactions
driver e93_orm_outside_job is
  class Customer = {id: Integer, name: String, city: String?, version: Integer} <: Record;

  table customers: Customer in "shop" is
    key (id);
    generated (id);
    version version;
  end customers;

  process main is
    new shop := database.connect("shop");
    shop.script("sql/schema.sql");

    new c := {id: 0, name: "Ann", city: null, version: 0} :Customer;
    let customers <+ c;
    print c.id;
    new d := customers.find!(1);
    let d.city := "Rome";
    new r := shop.query_one!(:Customer)("select id, name, city, version from customers where id = ?", 1);
    print "{r.city} {r.version}";
  return;
end e93_orm_outside_job;
