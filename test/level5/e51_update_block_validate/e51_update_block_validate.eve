# validate runs at the end of an update block, with all the fields changed together
** spec: library/database.md#the-update-block
driver e51_update_block_validate is
  class Customer = {id: Integer, name: String, city: String?, version: Integer} <: Record is
    method validate(@self) is
      expect self.name <> "";
    return;
  end Customer;

  table customers: Customer in "shop" is
    key (id);
    generated (id);
    version version;
  end customers;

  process main is
    new shop := database.connect("shop");
    shop.script("sql/schema.sql");

    add: job
    do
      new c := {id: 0, name: "Ann", city: null, version: 0} :Customer;
      let customers <+ c;
    done add;

    change: job
    do
      new c := customers.find!(1);
      update c do
        let city := "Lyon";
        let name := "";
      done;
      print "not reached";
    done change;
  recover
    new code := $error.code;
    print "invalid: {code}";
  return;
end e51_update_block_validate;
