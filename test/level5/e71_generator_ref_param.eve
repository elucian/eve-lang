# a generator has inputs only, by value: an @ parameter is a compile error (D-067)
** spec: syntax/declarations.md#generators-level-5
driver e71_generator_ref_param is
  generator fill(@total: Integer) => (@x: Integer) is
    yield 1;
  return;

  process main is
    print "x";
  return;
end e71_generator_ref_param;
/*@expect
{
  "syntax_error": true,
  "exit": 65,
  "contains": [
    "a generator has inputs only, by value"
  ]
}
*/
