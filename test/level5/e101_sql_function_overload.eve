# a sql function can not be overloaded: SQL finds a function by its name (D-166)
** spec: library/database.md#sql-functions
primary aspect e101_sql_function_overload is
  sql function twice(x: Integer) => (@result: Integer) is
    let result := x * 2;
  return;

  sql function twice(x: Real) => (@result: Real) is
    let result := x * 2.0;
  return;

  process main is
    print twice(2);
  return;
end e101_sql_function_overload;
/*@expect
{
  "syntax_error": true,
  "exit": 65,
  "contains": ["can not be overloaded"]
