# a top-level name declared twice in a macro is a compile error: one scope for the whole file
** spec: syntax/declarations.md#eve-macro-level-5

set limit = 3 :Integer;

procedure limit() is
  print "limit";
return;

primary aspect e64_macro_duplicate_name is
  process main is
    print limit;
  return;
end e64_macro_duplicate_name;
/*@expect
{
  "syntax_error": true,
  "exit": 65,
  "contains": [
    "'limit' is already declared in this scope"
  ]
}
*/
