# a key field can not be changed in an update block: a compile error (D-158)
** spec: library/database.md#the-update-block
driver e43_update_block_key is
  class Customer = {id: Integer, name: String, city: String?, version: Integer} <: Record;

  table customers: Customer in "shop" is
    key (id);
  end customers;

  process main is
    j: job
    do
      new c := customers.find!(1);
      update c do
        let id := 5;
      done;
    done j;
  return;
end e43_update_block_key;
