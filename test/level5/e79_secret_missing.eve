# a secret that the machine does not have is the error key, code 11 (data-language.md#secrets)
** spec: library/data-language.md#secrets
primary aspect e79_secret_missing is
  process main is
    new k := secret.get("no_such_secret");
    print "not reached";
  recover
    print "code: {$error.code}";
  return;
end e79_secret_missing;
