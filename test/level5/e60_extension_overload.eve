# an extension method with another signature overloads the method of the class (D-150)
** spec: syntax/declarations.md#overloading
primary aspect e60_extension_overload is
  class Counter = {n: Integer} <: Object is
    public method add(@self, k: Integer) is
      let self.n += k;
    return;
  end Counter;

  method add(@self: Counter, k: String) is   ** another signature: it overloads
    let self.n += k.length();
  return;

  process main is
    new c := Counter(n: 0);
    c.add(5);
    c.add("abc");
    print c.n;
  return;
end e60_extension_overload;
/*@expect
{
  "stdout": [
    "8"
  ]
}
*/
