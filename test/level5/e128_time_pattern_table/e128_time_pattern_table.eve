    new t := time.clock(0, 0, 0);
    new line := "";
    new bad := 0;
    new trips := 0;
    for k in (1..160) do
      let i := Instant.parse(stamps[k]);
      let line := time.format(i, "yyyy-MM-dd'T'HH:mm:ss.SSSSSSXXX") + "|" + time.format(i, "EEE, d MMM yy HH:mm") + "|" + time.format(i, "EEEE dd MMMM yyyy") + "|" + time.format(i, "h:mm:ss.SSS a") + "|" + time.format(i, "yyyyMMdd-HHmmss") + "|" + time.format(i, "DDD/ww/Q");
      if line <> expected[k] do
        print "differs at {k}: {line} expected {expected[k]}";
        let bad += 1;
      done;
      if time.parse(time.format(i, "yyyy-MM-dd'T'HH:mm:ss.SSSSSSXXX"), "yyyy-MM-dd'T'HH:mm:ss.SSSSSSXXX") <> i do
        let bad += 1;
      done;
      let trips += 1;
      if time.parse(time.format(i, "yyyyMMdd HHmmss.SSSSSS XXX"), "yyyyMMdd HHmmss.SSSSSS XXX") <> i do
        let bad += 1;
      done;
      let trips += 1;
      let d := time.parse(time.format(i, "EEEE dd MMMM yyyy"), "EEEE dd MMMM yyyy");
      if d.format("yyyy-MM-dd") <> time.format(i, "yyyy-MM-dd") do
        let bad += 1;
      done;
      let trips += 1;
      let t := time.parse(time.format(i, "h:mm:ss.SSSSSS a"), "h:mm:ss.SSSSSS a");
      if t.format("HH:mm:ss.SSSSSS") <> time.format(i, "HH:mm:ss.SSSSSS") do
        let bad += 1;
      done;
      let trips += 1;
    done;
    expect bad == 0;
    print 160 - bad, trips;
  return;
end e128_time_pattern_table;
