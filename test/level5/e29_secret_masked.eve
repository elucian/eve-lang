# a Secret is never printed: print and interpolation write ***
** spec: library/data-language.md#secrets
primary aspect e29_secret_masked is
  process main is
    new s := Secret("hunter2");
    print s;
    print "token: {s}";
  return;
end e29_secret_masked;
