# gzip.write(path, data) writes a String or Bytes as a gzip file; the writers of csv, json and txt compress a path that ends in .gz, as the readers inflate it (data-language.md#compression)
** spec: library/data-language.md#compression
primary aspect e165_gzip_write is
  class Item = {name: String, qty: Integer} is
  end Item;

  process main is
    gzip.write("out/hello.txt.gz", "hello gzip\nsecond line\n");
    gzip.write("out/raw.gz", Bytes.from_hex("00ff10"));
    print fs.read_bytes!("out/hello.txt.gz")[1..3].hex();
    for line in fs.lines!("out/hello.txt.gz") do
      print line;
    done;
    for chunk in gzip.open!("out/raw.gz") do
      print chunk.hex();
    done;
    new items := (Item(name: "a", qty: 1), Item(name: "b", qty: 22));
    csv.write("out/items.csv.gz", items);
    json.write("out/items.json.gz", items);
    print fs.read_bytes!("out/items.csv.gz")[1..2].hex();
    for r in csv.read!(:Item)("out/items.csv.gz") do
      print "csv {r.name} {r.qty}";
    done;
    for r in json.read!(:Item)("out/items.json.gz") do
      print "json {r.name} {r.qty}";
    done;
    new big := "";
    for i in (1..2000) do
      let big := big + "0123456789abcdef";
    done;
    gzip.write("out/big.gz", big);
    print fs.read_bytes!("out/big.gz").length() < 400;
    print gzip.open!("out/big.gz").count();
    gzip.write("out/bad.gz", 5);
    print "not reached";
  recover
    print "error {$error.code}";
  return;
end e165_gzip_write;
