# a sql function is deterministic: its name can not end with ! (D-166)
** spec: library/database.md#sql-functions
primary aspect e99_sql_function_bang is
  sql function stamp!(x: Integer) => (@result: Integer) is
    let result := x;
  return;

  process main is
    print stamp!(1);
  return;
end e99_sql_function_bang;
