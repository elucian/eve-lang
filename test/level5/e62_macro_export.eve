# a macro exports nothing: export is a compile error
** spec: syntax/declarations.md#eve-macro-level-5

function twice(x: Integer) => (@result: Integer) is
  let result := x * 2;
return;

export (twice);

primary aspect e62_macro_export is
  process main is
    print twice(2);
  return;
end e62_macro_export;
