# json.parse and json.text: JSON text in memory and plain values (F-LIB-05, D-189)
** spec: library/data-language.md#json-text-in-memory-jsonparse-and-jsontext
primary aspect f06_json_text is
  process main is
    new v := json.parse("\{\"id\": 7, \"name\": \"eve\", \"tags\": [1, 2.5, true, null], \"sub\": \{\"ok\": false\}\}");
    print v["id"] + 1;
    print v["name"];
    print v["tags"][2];
    print v["sub"]["ok"];
    print json.text(v);
    print json.text([1, 2, 3]);
    print json.text("a\"b");
    print json.text(json.parse("[]"));
    json.parse("\{\"open\": ");
    print "never";
  recover
    print "bad json";
  return;
end f06_json_text;
