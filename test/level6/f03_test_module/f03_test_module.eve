{
  "stdout": [
    "ok one is positive",
    "ok sum",
    "ok text",
    "ok not the same",
    "ok pi",
    "FAIL wrong on purpose: expected 3, got 2",
    "passed 5 failed 1",
    "5 passed, 1 failed"
  ],
  "exit": 4
}
