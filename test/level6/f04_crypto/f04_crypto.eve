# the system module crypto: hashes, HMAC, codecs, random bytes (F-LIB-10, D-189)
** spec: library/crypto.md
primary aspect f04_crypto is
  process main is
    print crypto.sha256("abc");
    print crypto.sha512("abc");
    print crypto.hmac_sha256("key", "The quick brown fox jumps over the lazy dog");
    print crypto.hex_encode("Eve");
    print crypto.hex_decode("457665");
    print crypto.base64_encode("Eve language");
    print crypto.base64_decode("RXZlIGxhbmd1YWdl");
    print crypto.same("abc", "abc");
    print crypto.same("abc", "abd");
    print crypto.random_hex!(8).length();
    fs.write("f04_data.txt", "abc");
    print crypto.sha256_file!("f04_data.txt");
    fs.remove("f04_data.txt");
    print crypto.hex_decode("zz");
    print "never";
  recover
    print "bad hex";
  return;
end f04_crypto;
