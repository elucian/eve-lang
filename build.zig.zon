.{
    // The package of Eve: the packages evecm, evecp and evevm (code/<component>/) and the command `eve` (design-packages.md) are built
    // from here, and the one version of everything is written once, below (D-167).
    .name = .eve,
    .version = "0.0.7",
    .fingerprint = 0xf5e09b7eca5ed987, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .evecm = .{ .path = "code/evecm" },
        .evecp = .{ .path = "code/evecp" },
        .evevm = .{ .path = "code/evevm" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "code",
        "lib",
    },
}
