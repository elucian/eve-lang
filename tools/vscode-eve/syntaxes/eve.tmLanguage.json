{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eve",
  "scopeName": "source.eve",
  "fileTypes": [
    "eve"
  ],
  "_generated": "by tools/vscode-eve/gen_vscode.py from spec/lexical/keywords.json: do not edit by hand",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#symbols"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "markup.heading.2.eve",
          "match": "^##.*$"
        },
        {
          "name": "markup.heading.1.eve",
          "match": "^#.*$"
        },
        {
          "name": "comment.line.double-asterisk.eve",
          "match": "\\*\\*.*$"
        },
        {
          "name": "comment.block.expression.eve",
          "begin": "\\(\\*\\*",
          "end": "\\*\\*\\)"
        },
        {
          "name": "comment.block.eve",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.eve",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.double.eve",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "constant.character.escape.eve",
          "match": "\\\\."
        },
        {
          "name": "constant.character.escape.eve",
          "match": "&[A-Za-z_][A-Za-z0-9_]*;"
        },
        {
          "name": "meta.interpolation.eve",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.eve"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.eve"
            }
          },
          "patterns": [
            {
              "include": "#numbers"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "string.quoted.single.eve",
          "match": "'(?:[^'\\\\\\n]|\\\\.)*'"
        },
        {
          "name": "constant.character.eve",
          "match": "\\bU\\+[0-9A-Fa-f]+\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.eve",
          "match": "\\b0[xX][0-9a-fA-F_]+[bBsShHdD]?\\b"
        },
        {
          "name": "constant.numeric.binary.eve",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.eve",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?[dDbBsShH]?\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.system.eve",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.parameter.reference.eve",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.eve",
          "match": "\\b(?:False|Null|True|null)\\b"
        },
        {
          "name": "keyword.control.eve",
          "match": "\\b(?:all|cancel|do|done|else|error|for|if|job|loop|match|on|one|other|parallel|repeat|then|update|when|while|within)\\b"
        },
        {
          "name": "keyword.control.flow.eve",
          "match": "\\b(?:abort|break|exit|over|panic|pass|raise|resume|retry|return|skip|stop|yield)\\b"
        },
        {
          "name": "storage.type.eve",
          "match": "\\b(?:aspect|class|constructor|def|destructor|function|generator|method|module|new|procedure|process|set|trait)\\b"
        },
        {
          "name": "storage.modifier.eve",
          "match": "\\b(?:concurrent|exclusive|primary)\\b"
        },
        {
          "name": "keyword.operator.word.eve",
          "match": "\\b(?:and|as|eq|in|is|not|or|xor)\\b"
        },
        {
          "name": "keyword.other.eve",
          "match": "\\b(?:apply|assert|await|call|defer|end|expect|export|finalize|from|initialize|let|print|read|recover|self|spawn|start|use|wait|write)\\b"
        },
        {
          "name": "storage.modifier.eve",
          "match": "^\\s*(?:after|async|cached|column|commit|direct|external|generated|key|managed|only|private|protected|public|read|reference|rollback|sql|table|temporary|to|version)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.eve",
          "match": "\\b(?:Array|Atomic|Byte|Bytes|Channel|Class|Comparable|Connection|DataMap|DataSet|Date|Decimal|Duration|Error|File|Float|Folder|Function|HashMap|Huge|Instant|Integer|Iterable|Lambda|List|Logic|Memory|Natural|Object|Ordinal|Printable|Rational|Real|Record|Rune|Secret|Short|Stream|String|Symbol|Table|Text|Time|Type|Variant|Warning)\\b"
        },
        {
          "name": "entity.name.type.eve",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.eve",
          "match": "\\b[a-z_][A-Za-z0-9_]*!?(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.eve",
          "match": "\\.\\.<|>\\.\\.<|\\.\\.\\.|\\.\\.|><|=\\~|!\\~|:=|==|<>|=>|<:|:>|<\\-|\\->|<\\+|\\+>|<=|>=|\\&\\&|\\|\\||\\+=|\\-=|\\*=|/=|%=|\\^=|\\+|\\-|\\*|/|\\^|%|\\&|\\||<|>|=|!|\\?|:|\\~"
        }
      ]
    }
  }
}
