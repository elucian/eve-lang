    "title": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "#[^\\n]*"
        }
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\*\\*[^\\n]*"
        }
      }
    },
    "comment_expr": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\(\\*\\*([^*]|\\*[^*]|\\*\\*[^)])*\\*\\*\\)"
        }
      }
    },
    "comment_block": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "\\/\\*([^*]|\\*+[^*\\/])*\\*+\\/"
        }
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\"\"\"([^\"]|\"[^\"]|\"\"[^\"])*\"\"\""
          },
          {
            "type": "PATTERN",
            "value": "\"([^\"\\\\\\n]|\\\\.)*\""
          }
        ]
      }
    },
    "symbol": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "'([^'\\\\\\n]|\\\\.)*'"
          },
          {
            "type": "PATTERN",
            "value": "U\\+[0-9A-Fa-f]+"
          }
        ]
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "0[xX][0-9a-fA-F_]+"
          },
          {
            "type": "PATTERN",
            "value": "0[bB][01_]+"
          },
          {
            "type": "PATTERN",
            "value": "[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?[dD]?"
          }
        ]
      }
    },
    "system_variable": {
