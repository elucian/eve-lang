# using symbol ranges
driver symbol_range is
process main is
  print ('0'..'5') ** ('0','1','2','3','4','5')

  ** following statements should pass
  expect '0' in ('0'..'9');  ** will pass   
  expect 'X' in ('A'..'Z');  ** will pass

  ** iterate over range of symbols
  for d in ('a'...'c') do
    for n in ('1'..'3') do
       print d || n || ',';
    done;
  done;
return;  
end symbol_range;

** expected output 
/* 
a1,a2,a3
b1,b2,b3
c1,c2,c3
*/