# main process with parameters
driver method_call is

  method test(a: Integer) is
    ** print is a system method
    print "argument list has #{a} arguments";

    ** list the arguments
    loop
       let arg: String;
    for arg in args do
       print arg;
    done;
  return;

  process main(*args) is
    ** check type
    expect args is List;

    ** number of arguments received:
    let c := args.length();

    ** verify condition and exit
    panic if c == 0;  ** early interruption

    ** call local method and exit  
    test(c);       ** method call
    over; ** normal end
  return;
end method_call;