# driver with parameters
driver method_call(*args) is

method test(Integer a) is 
process
    ** print is a system method
    print 'argument list has #n arguments' ? a; 

    ** list the arguments
    loop
       new arg: String;
    for arg in args do
       print arg;
    done;
return;

process
    ** check type
    expect args is List;

    ** number of arguments received:
    new c := args.length();

    ** verify condition and exit
    over 1; if c == 0;  ** early interruption

    ** call local method and exit  
    test(c);       ** method call
    over 0; ** return default 
return;