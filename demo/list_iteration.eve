# list iteration using a for loop
driver list_iteration is

  let my_list :()Symbol; **  empty list
  process main is
    ** later initialization
    my_list := ('a', 'b', 'c', 'd', 'e');

    ** visit the elements until 'd' and stop
    loop
      let e :Symbol; ** control variable
    for e in my_list do
      write e; **  put e in the buffer for the console
      if e == 'd' do
        break; **  early termination
      else
        write ", "; ** add separator
      done;
    done;
    print; ** a, b, c, d
  return;
end list_iteration;

/* Note: In Eve nothing is printed when you write,
   you must also print at the end to create a new line */
