# multiple line demo
driver multi_line is

  let x :Integer;
  let a :{:}(Integer, Integer);
  process main is
    ** multi-row expression
    x := 1 +
         2 +
        (3 + 4)
       + 5;
    expect x == 15;

    ** multi-row literal
    a := {
         1: 2
        ,3: 4
        ,5: 6
    };
    expect a[3] == 4;
  return;
end multi_line;

/* This is why, Eve use semicolon for every statement,
   to be able to write multi-line statements without effort. */
