#numeric literals
driver numeric_literals is
  set i: Integer; ** Initial value = 0
  set n: Natural; ** Initial value = 0
  set r: Real;    ** Initial value = 0.00
  process main is
    i := 9223372036854775807;  **  maximum
    n := 18446744073709551615; **  maximum
    r := 3.25
    
    ** binary numeric_literals
    let bn  := OB11111111 ** negative binary
    let bp  := O101010101 ** positive binary 
    
    ** hexadecimals 
    let hex := OX123456789ABCDEF;

    ** scientific notation
    let s := 3.14E-2; 
    expect s == 0.0314;
  return;
end numeric_literals;

