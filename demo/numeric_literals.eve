# numeric literals
driver numeric_literals is
  let i :Integer; ** Initial value = 0
  let n :Natural; ** Initial value = 0
  let r :Real;    ** Initial value = 0.0
  process main is
    i := 9223372036854775807;  **  maximum
    n := 18446744073709551615; **  maximum
    r := 3.25;

    ** binary literals are Natural
    let bn := 0b11111111;  ** 255
    expect bn == 255;

    ** hexadecimal literals are Natural
    let hex := 0x123456789ABCDEF;
    expect 0xFF == 255;

    ** a Rational is evaluated when needed
    let q = 3\4 :Rational;
  return;
end numeric_literals;
