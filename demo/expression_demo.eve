# simple expressions in print statement
driver expression_demo is

  process main is
    print 10;
    print "this is a test";
    ** complex expressions can use ()
    print (10 + 10 + 15); ** numeric expression: 35
    print (10 > 5) or (2 < 3); ** logical expression: True
    ** a list of expressions is enclosed in ()
    print (1, 2, 3);    ** 1,2,3
    print (10, 11, 12); ** 10,11,12
    ** write does not add a new line
    write (1, 2);
    write (3, 4);
    ** now create a new line after the text
    print; ** 1234

    ** logic expressions
    print (1 < 2 and 7 > 4);    ** True
    print (1 < 1 or 1 == 1);    ** True
    print (not True == False);  ** True
  return;
end expression_demo;
