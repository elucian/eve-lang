# null string and Null value
driver null_string is

  let str :String;           ** Null string
  set btr = "" :String;      ** Empty string
  process main is
    ** null string
    expect str is Null;

    str := "";
    expect str is String;
    expect str is not Null;
    expect str == "";
    expect str <> " ";
    expect btr <> " ";

    ** initialized string
    expect btr == "";
    expect str == btr;
  return;
end null_string;

/* Note: Strings in Eve are immutable
   In Eve, Null and Empty are different things */
