# convert number to string
driver number_to_string is

  let s :String;
  set v = 1000 :Integer;
  process main is
    s := format(v);     **  explicit coercion
    expect s == "1000"; **  check string value

    print "s = \#{v}";  **  use interpolation
  return;
end number_to_string;

/* \#{expr} inserts a number into a string,
   \s{expr} inserts any value as a string */
