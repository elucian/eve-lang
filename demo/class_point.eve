# demonstrate a class
driver point_demo is
  ** define class Point, from root Object
  class Point = {x, y :Double} <: Object is
    ** constructor, declared inside the class body
    ** first list: @self, it needs no type; second list: the parameters
    constructor(@self)(x = 0, y = 0 :Double) is
      ** self is created by the superclass constructor
      self := new Object();
      let self.x := x;
      let self.y := y;
    return;
  end Point;
  # using the class
  process main is
    ** initialize the points
    let p1 := new Point(x:1, y:2);
    let p2 := new Point(x:2, y:2);
    ** use string patterns to print attributes
    print "p1 = (x:#n, y:#n)" ? (p1.x,p1.y);
    print "p2 = (x:#n, y:#n)" ? (p2.x,p2.y);
  return;
end point_demo;

/* A class is basically a dictionary with additional methods,
   some attributes can be created dynamical. */