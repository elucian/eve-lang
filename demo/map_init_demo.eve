# demo how to initialize a HashMap
driver map_init_demo is

  ** a HashMap variable with String keys and Integer values
  let table1 :{:}(String, Integer);
  process main is
    ** initialize the table using a literal of key:value pairs
    table1 := {"one": 1, "two": 2};
    expect table1 is HashMap;

    ** start from the empty HashMap {:} and create the elements
    let table2 := {:};
    table2["one"] := 1;
    table2["two"] := 2;

    ** verification using "==" operator
    expect table1 == table2;
    expect table1 is not table2;
    expect table2 is HashMap;
  return;
end map_init_demo;

/* The operator == execute a deep comparison
   operator "is" execute a shallow comparison
*/
