# ranges used as domains
/* a domain is delimited by two limits
   created with literals like (min..max)
   lower limit can be excluded using ">" like (min>..max)
   upper limit can be excluded using "<" like (min..<max)
   open end domain is possible using "?" like (0..?)
*/
driver domain_demo is

  ** declare a global domain
  set domain := (0..1);

  process main is
    ** compare domains
    expect domain == (0..1);

    print domain; ** (0..1)

    ** using domain
    expect 0 in domain;
    expect 1 in (0..1);
    expect 0.5 in (0.0..1.0);  ** the zeros give the precision 0.1

    ** exclude limits
    expect 0 not in (0>..1);
    expect 1 not in (0..<1);
    expect 0.5 in (0.0>..<1.0);

    ** open end limits
    expect 999 in (0..?);
    expect -1  in (?..0);

    ** a value checked against two domains
    let v := 12;
    expect (v in (0..4)) or (v in (12..24));

    ** precise numbers domain (using ratio 0.01)
    let grid := (0..1)(0.01);
    expect 0.25  in grid;     ** a precise number
    expect 0.253 not in grid; ** not a precise number
  return;
end domain_demo;
