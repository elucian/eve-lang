# Using "as" operator with Date type
driver date_demo is

  /* A date is read with one of the formats YMD, MDY and DMY:
     "parse" reads a string, "as" formats a date one way.
  */
  set date := "2019/01/30".parse(YMD);

  process main is
    print date; **  2019/01/30

    ** format the date and print
    print date as DMY; **  30/01/2019
    print date as MDY; **  01/30/2019

    ** verification of the format
    expect (date as DMY) == "30/01/2019";
  return;
end date_demo;
