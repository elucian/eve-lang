# comment demo: a title comment starts with # at column 0
## a subtitle comment starts with ##, also at column 0
/*--------------------------------
|  Block comments can be banners  |
--------------------------------*/
driver comment_demo is
  ** two stars: a comment to the end of the line, indented with the code
  let a = 0 :Integer;

  process main is
    /* a block comment can span many lines;
       it is useful to comment out code for debug.
       Block comments do not nest. */

    ** in the next expression we use an expression comment
    a := a + 1 (** * (a - 1) **) - 1;

    print a; ** end of line comment
  return;
end comment_demo;

/* Different styles of comments, can be used to generate
   better documentation for the code using automatic tools.
   Syntax color helps to colorize the comments in different
   ways, improving visual aspect of the code.
*/
