# list split demo
driver list_split is

  process main is
    ** split a string into a list of strings
    let str := "1,2,3";
    let lst := str.split(",");
    print lst; ** ("1","2","3")

    ** method split is also a public function:
    ** the object is the first argument
    let lst2 := split(str, ",");
    expect lst == lst2;    ** list comparison is a deep comparison
  return;
end list_split;

/* Note. In Eve, we use == to compare two objects
   Unlike Java, == do not compare references but properties */
