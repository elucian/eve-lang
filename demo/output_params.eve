# demo output parameters and method call
driver output_params is

  ** a method can have side-effects; it may also return a result
  method add(p1 = 0, p2 = 1 :Integer, @out :Integer) is
    out := p1 + p2;
  return;

  let result :Integer;
  process main is
    ** a reference argument requires a variable marked with @
    add(1, 2, @result);
    expect result == 3;
    print result;     **  expected value 3

    ** negative tests, rejected by the compiler:
    ** add(1, 2, result);  "out" requires @
    ** add(1, 2, @4);      "out" requires a variable
  return;
end output_params;

/* Note: @out parameter use a prefix @
   this indicate pass by reference of a variable */
