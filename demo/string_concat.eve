# example of string concatenation
driver string_concat is

  process main is
    ** set string value using the "+" operator
    let str := " this " + "string";
    expect str == " this string";

    ** use string interpolation
    print "I have insert \s{str} here!";

    ** concatenate string with collection
    print "digits = " + (1, 2, 3).join(",");


    ** interpolation with a format: i3 is an integer of width 3
    print "these numbers \#{1:i3},\#{3:i3},\#{5:i3} are prime";
  return;
end string_concat;

/* Note: a string concatenated with a symbol or a number
   gives a String: "a" + 1 is "a1".
*/
