# demonstrate how to compare strings
driver compare_strings is

  ** define a global constant
  set str := "foo";

  /* a driver has one process, main:
     it is the entry point of the script
  */
  process main is
    expect "" <> " ";            ** the empty string is not a space
    expect "this" == "this";     ** true (same value)
    expect " this" <> "this";    ** a leading space is significant
    expect "this " <> "this";    ** a trailing space is significant

    ** create new local strings
    let str1 := "bar";
    let str2 := "foo";

    ** string relations
    expect str1 == "bar";  ** check initial value
    expect str1 < str2;    ** "bar" comes before "foo"
    expect str2 > str1;
    expect str1 <= str;    ** compare with the global
    expect str2 == str;    ** same value
  return;
end compare_strings;
