# demo function with parameters
driver function_params is

  ** b is optional: it has a default value
  function sum(a :Integer, b = 0 :Integer) => (@result :Integer) is
    result := a + b;
  return;

  process main is
    print sum(1, b: 2);  ** 3
    print sum(2, b: 4);  ** 6

    expect sum(1) == 1;             ** implicit b = 0
    expect sum(a: 5, b: 10) == 15;  ** parameters by name
  return;
end function_params;
