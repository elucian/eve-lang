# declaration of a text literal
driver text_literal is

  process main is
    let my_text := """
    "Opportunity is missed by most people
    because it is dressed in overalls
    and looks like work."
    """;
    print my_text;
  return;
end text_literal;

/* expected output:
"Opportunity is missed by most people
because it is dressed in overalls
and looks like work."
*/

/* A text literal is enclosed in triple quotes """...""" and is raw:
   it has no escapes and keeps the new lines. The indentation of the
   closing quotes is removed from every line.
*/
