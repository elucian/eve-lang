# print all arguments
driver test_args is

  method test(*args :String) is
    print args;
  return;

  process main is
    ** define a new list of arguments
    let arguments := ("1", "2", "3");

    ** transfer arguments by position using the spreading operator (*)
    ** you can use operator "*" to spread the collection elements
    test(*arguments);

    ** call method with variable number of arguments
    test("a", "b", "c"); ** use 3 arguments
    test("a", "b");      ** use 2 arguments
  return;
end test_args;

/* observe: a method is called as a statement, "call" is not used
   "call" is only for shell commands
*/
