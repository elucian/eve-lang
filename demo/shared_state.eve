# verify shared state influence
driver shared_states is

  process main is
    ** the precision of comparisons (default 0.001)
    $epsilon := 0.01;

    ** "/" always returns a Real number
    let x := 10 / 3;
    print x; ** 3.3333333333333335

    ** equality is affected by precision
    expect 3.33   == x;
    expect 3.3333 == x;
    expect 3.339  == x;
    expect 3.35   <> x;

    ** call built-in functions
    print floor(x);   ** expected 3
    print ceiling(x); ** expected 4

    ** relation expectations
    expect (3.33 <= x) and (x <= 3.34);

    ** overwrite the initial settings
    $epsilon := 0.0001;
    expect 3.33335 == x;
    expect 3.3333  == x;
    expect 3.33    <> x;

    ** relation expectations
    expect (3.3333 <= x) and (x <= 3.3334);
  return;
end shared_states;

/* $epsilon is a system variable, its default value in Eve is 0.001 */
