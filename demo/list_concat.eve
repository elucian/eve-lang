# demo to concatenate lists using <+
driver list_concat is

  set a := ('a', 'b', 'c');
  set b := ('1', '2', '3');
  process main is
    let c := a <+ b;
    expect c[1] == 'a';  ** check first element
    expect c[-1] == '3';  ** check last element

    let d := b <+ a;
    expect d[1] == '1';  ** check first element
    expect d[-1] == 'c';  ** check last element

    print c; **  ('a','b','c','1','2','3')
    print d; **  ('1','2','3','a','b','c')
  return;
end list_concat;

/* Note: Lists in EVE are enclosed in round brackets ()
   We use square brackets [] for array literals and element access
*/
