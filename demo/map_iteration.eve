# map iteration
driver map_iteration is

  set my_map := {"a": 1, "b": 2, "c": 3};
  process main is
    for (key: value) in my_map do
      ** print pairs (key: value)
      print "(\s{key}: \#{value})";
    done;
  return;
end map_iteration;

/* Note: the loop header is missing because it is optional.
   The types of key and value are inferred from the HashMap */
