# map iteration
driver map_iteration is

  set my_map := {("a":1),("b":2),("c":3)};
  process main is
    for (key, value) in my_map do
      ** print pairs (key, value)
      print('("' + key + '",' + value +')');
    done;
  return;
end map_iteration;

/* Note: the loop header is missing because is optional.
   key value type is automatically inferred from the HashMap */