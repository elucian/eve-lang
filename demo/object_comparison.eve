#object comparison demo
driver object_compare is

global
    set o = 1: Integer; 
    set n = 1; Integer;
process main is
    ** equal values and types
    expect  o  == n; 
    expect  not (o <> n);     
    
    ** not the same location
    expect  not (o is n); 
    expect  o is not n;     
   
    ** alter one value        
    n := 2; 

    ** equal values and types
    expect  o  <> n; 
    expect  not (o == n);         
return;
end object_compare;
