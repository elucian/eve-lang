# demonstrate set, let and the assignment
/*-----------------------------------
  set declares a constant, let a variable,
  := changes a value, expect makes a test
------------------------------------*/
driver assign_demo is
  ** a constant and a global variable
  set limit = 10 :Integer;
  let a := 2;    ** the type Integer is inferred

  process main is
    expect a == 2;   ** verify the initial value
    a += 2;          ** alter the global variable
    expect a == 4;   ** verify the change

    ** create a new local variable
    let b := a + 0.5;  ** evaluate an expression
    expect b == 4.5;   ** check the expression value
    expect a < limit;
  return;
end assign_demo;
