# using operator "is" to check type
driver type_check is

  ** define object and initialize
  set r := {name: "test", age: 24};
  ** define hash map
  set t := {"key1": 1, "key2": 2};
  ** define two symbols
  set x = 'x' :Symbol;
  set y = 'y' :Symbol;

  process main is
    ** check variable types using introspection
    expect type(r.name) is String;
    expect type(r.age)  is Integer;
    expect type(t["key1"]) is Integer;

    ** using operator is with type
    expect t is HashMap;
    expect x is Symbol;
    expect type(y) is Symbol;
  return;
end type_check;
