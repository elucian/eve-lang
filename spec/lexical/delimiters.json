{
  "$schema": "../schema/delimiters.schema.json",
  "specVersion": "0.1-draft",
  "items": [
    {
      "id": "shebang",
      "open": "#!",
      "close": "end of line",
      "kind": "comment",
      "nests": false,
      "multiline": false,
      "summary": "Shebang on line 1: a free script.",
      "status": "draft",
      "ref": "lexical/lexical.md#file-header",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#file-header"
    },
    {
      "id": "title",
      "open": "#",
      "close": "end of line",
      "kind": "comment",
      "nests": false,
      "multiline": false,
      "summary": "Title comment, indentation 0 only.",
      "status": "draft",
      "ref": "lexical/lexical.md#comments",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#comment-forms"
    },
    {
      "id": "subtitle",
      "open": "##",
      "close": "end of line",
      "kind": "comment",
      "nests": false,
      "multiline": false,
      "summary": "Subtitle comment, indentation 0 only.",
      "status": "draft",
      "ref": "lexical/lexical.md#comments",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#comment-forms"
    },
    {
      "id": "note",
      "open": "**",
      "close": "end of line",
      "kind": "comment",
      "nests": false,
      "multiline": false,
      "summary": "Note: anywhere outside a literal.",
      "status": "draft",
      "ref": "lexical/lexical.md#comments",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#comment-forms"
    },
    {
      "id": "expression-comment",
      "open": "(**",
      "close": "**)",
      "kind": "comment",
      "nests": false,
      "multiline": true,
      "summary": "Expression comment, may span lines, does not nest.",
      "status": "draft",
      "ref": "lexical/lexical.md#comments",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#comment-forms"
    },
    {
      "id": "block-comment",
      "open": "/*",
      "close": "*/",
      "kind": "comment",
      "nests": false,
      "multiline": true,
      "summary": "Block comment, ends at the first `*/`, does not nest.",
      "status": "draft",
      "ref": "lexical/lexical.md#comments",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#comment-forms"
    },
    {
      "id": "symbol",
      "open": "'",
      "close": "'",
      "kind": "literal",
      "nests": false,
      "multiline": false,
      "summary": "Rune: one Unicode code point; `''` is nil.",
      "status": "draft",
      "ref": "lexical/lexical.md#literals",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#strings",
      "escapes": true
    },
    {
      "id": "string",
      "open": "\"",
      "close": "\"",
      "kind": "literal",
      "nests": false,
      "multiline": false,
      "summary": "String: UTF-8 text on one line; placeholders `{name}` and `{name % format}`; literal braces `\\{` `\\}` (D-102).",
      "status": "draft",
      "ref": "lexical/lexical.md#literals",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#strings",
      "escapes": true
    },
    {
      "id": "text",
      "open": "\"\"\"",
      "close": "\"\"\"",
      "kind": "literal",
      "nests": false,
      "multiline": true,
      "summary": "Text literal on several lines: raw, no escapes, indentation of the closing quotes removed.",
      "status": "draft",
      "ref": "lexical/lexical.md#literals",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#strings",
      "escapes": false
    },
    {
      "id": "placeholder",
      "open": "{",
      "close": "}",
      "kind": "escape",
      "nests": false,
      "multiline": false,
      "summary": "Placeholder inside a string: `{name}` or `{name % format}`; the value is written by its type; a literal brace is `\\{` or `\\}` (D-102).",
      "status": "draft",
      "ref": "lexical/lexical.md#literals",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#escapes"
    },
    {
      "id": "code-point-placeholder",
      "open": "{U+",
      "close": "}",
      "kind": "escape",
      "nests": false,
      "multiline": false,
      "summary": "Placeholder with a Unicode code point, 1 to 6 hexadecimal digits: `{U+03B1}` is α (D-119).",
      "status": "draft",
      "ref": "lexical/lexical.md#literals",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#escapes"
    },
    {
      "id": "list",
      "open": "(",
      "close": ")",
      "kind": "collection",
      "nests": false,
      "multiline": false,
      "summary": "List literal, parameters and arguments, grouping of an expression.",
      "status": "draft",
      "ref": "lexical/lexical.md#literals",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#collections"
    },
    {
      "id": "array",
      "open": "[",
      "close": "]",
      "kind": "collection",
      "nests": false,
      "multiline": false,
      "summary": "Array literal (vector, matrix); index and slice after a value; `m[x, y]` is `m[x][y]`.",
      "status": "draft",
      "ref": "lexical/lexical.md#literals",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#collections"
    },
    {
      "id": "brace",
      "open": "{",
      "close": "}",
      "kind": "collection",
      "nests": false,
      "multiline": false,
      "summary": "Ordinal, DataSet, DataMap or Object literal; `{}` empty DataSet, `{:}` empty DataMap.",
      "status": "draft",
      "ref": "lexical/lexical.md#literals",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#collections"
    },
    {
      "id": "statement-end",
      "open": ";",
      "close": null,
      "kind": "separator",
      "nests": false,
      "multiline": false,
      "summary": "Ends a statement.",
      "status": "draft",
      "ref": "lexical/lexical.md#tokens",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#punctuation"
    },
    {
      "id": "separator",
      "open": ",",
      "close": null,
      "kind": "separator",
      "nests": false,
      "multiline": false,
      "summary": "Separates elements, parameters and arguments.",
      "status": "draft",
      "ref": "lexical/lexical.md#tokens",
      "tutorial": "https://sagecode.org/projects/eve/syntax.html#punctuation"
    }
  ]
}
