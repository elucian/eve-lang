{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keywords",
  "type": "object",
  "required": [
    "specVersion",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "ref",
          "summary",
          "category"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "stable",
              "draft",
              "proposed",
              "reserved",
              "deprecated"
            ]
          },
          "ref": {
            "type": "string"
          },
          "contextual": {
            "type": "boolean",
            "description": "True: a keyword only where the grammar expects it; elsewhere an ordinary name (D-116)."
          },
          "tutorial": {
            "type": "string",
            "description": "Courtesy link to a tutorial section; informative, not part of the definition."
          },
          "summary": {
            "type": "string"
          },
          "category": {
            "enum": [
              "region",
              "declaration",
              "statement",
              "block",
              "operator",
              "modifier",
              "constant",
              "reserved"
            ]
          }
        }
      }
    }
  }
}
