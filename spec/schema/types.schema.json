{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "types",
  "type": "object",
  "required": [
    "specVersion",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "ref",
          "summary",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "stable",
              "draft",
              "proposed",
              "reserved",
              "deprecated"
            ]
          },
          "ref": {
            "type": "string"
          },
          "tutorial": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      }
    }
  }
}
