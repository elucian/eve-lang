{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spec index",
  "description": "spec/spec.json, generated by generator/evegen.py: every page with its sections, the data files and the feature files.",
  "type": "object",
  "required": ["pages", "data", "featureFiles"],
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "title", "lines", "bytes", "sections"],
        "properties": {
          "path": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string" },
          "lines": { "type": "integer" },
          "bytes": { "type": "integer" },
          "features": { "type": "array", "items": { "type": "string" } },
          "sections": { "type": "array", "items": { "type": "array" } }
        }
      }
    },
    "data": { "type": "array", "items": { "type": "object" } },
    "featureFiles": { "type": "array", "items": { "type": "object" } }
  }
}
