{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delimiters",
  "type": "object",
  "required": [
    "specVersion",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "ref",
          "summary",
          "open",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "stable",
              "draft",
              "proposed",
              "reserved",
              "deprecated"
            ]
          },
          "ref": {
            "type": "string"
          },
          "tutorial": {
            "type": "string",
            "description": "Courtesy link to a tutorial section; informative, not part of the definition."
          },
          "summary": {
            "type": "string"
          },
          "open": {
            "type": "string"
          },
          "close": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "comment",
              "literal",
              "escape",
              "collection",
              "separator"
            ]
          },
          "nests": {
            "type": "boolean"
          },
          "multiline": {
            "type": "boolean"
          },
          "escapes": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
