#!/bin/sh
# pre-commit: when keywords.json is committed, refresh the keyword lists of the tutorial highlighter (eve1.js).
# The tutorial is another repository (scl): the hook updates the file but cannot commit it for you.
if git diff --cached --name-only | grep -q "^spec/lexical/keywords.json$"; then
  python script/genkeywords.py || exit 1
  echo "pre-commit: tutorial/js/eve1.js refreshed; commit it with: git -C tutorial add projects/eve/js/eve1.js"
fi

# the editors read the same words: evetx (keywords.zig) and the Zed grammar (tools/tree-sitter-eve/grammar.js)
if git diff --cached --name-only | grep -q "^spec/lexical/keywords.json$"; then
  python code/evetx/gen_keywords.py && python tools/zed-eve/gen_zed.py && python tools/vscode-eve/gen_vscode.py || exit 1
  git add code/evecm/src/ide/keywords.zig tools/tree-sitter-eve/grammar.js tools/tree-sitter-eve/queries/highlights.scm tools/zed-eve/languages/eve/highlights.scm tools/vscode-eve/syntaxes/eve.tmLanguage.json tools/vscode-eve/language-configuration.json
  echo "pre-commit: evetx keywords and the Zed grammar refreshed; run 'npx tree-sitter-cli generate' in tools/tree-sitter-eve to rebuild src/parser.c"
fi

# the AI tags of the Zig sources must point to real spec pages, anchors, features and decisions (plan A4)
if git diff --cached --name-only | grep -q "\.zig$"; then
  python script/tagcheck.py --staged || exit 1
fi

# the feature tables of design/version_map.md are generated from the feature sections (plan: design-ai-context.md, featmap.py)
if git diff --cached --name-only | grep -q "^design/version_map.md$"; then
  python script/featmap.py --write && python script/featmap.py --check || exit 1
  git add design/version_map.md
fi
